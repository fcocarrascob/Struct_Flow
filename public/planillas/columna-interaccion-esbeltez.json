  {
   "id": "r085",
   "kind": "text",
   "x": 40,
   "y": 4160,
   "src": "compresión positiva. Una capa a d_i con el eje neutro en c deforma:"
  },
  {
   "id": "r086",
   "kind": "program",
   "x": 40,
   "y": 4208,
   "src": "eps_s(c, d_i) := eps_cu*(c - d_i)/c"
