      "src": "━━ 7 · LAS PALANCAS: EL ESPESOR DE LA PLANCHA Y EL GRADO DEL PERNO ━━"
    },
    {
      "id": "t110",
      "kind": "text",
      "x": 40,
      "y": 5472,
      "src": "Subir la plancha de 10 a 12 mm mueve la cadena; subir el perno a A490 no mueve la cadena, pero sí al perno extremo"
    },
    {
      "id": "r064",
      "kind": "math",
      "x": 40,
      "y": 5520,
      "src": "t2 := 1.2 cm"
    },
    {
      "id": "r065",
      "kind": "math",
      "x": 40,
      "y": 5568,
      "src": "Rd_pro2 := 0.75*0.6*F_u*(d_pl - n_b*d_h)*t2 = tonf"
    },
    {
      "id": "r066",
      "kind": "math",
      "x": 40,
      "y": 5616,
      "src": "Rd_bc2 := 0.75*(min(0.6*F_u*(L_bv - 3.5*d_h)*t2, 0.6*F_y*L_bv*t2) + U_bs*F_u*(L_eh - d_h/2)*t2) = tonf"
    },
    {
      "id": "t114",
      "kind": "text",
      "x": 40,
      "y": 5664,
      "src": "A490 = Grupo 150, rosca incluida: la Tabla J3.2 da 68 ksi (470 MPa)"
    },
    {
      "id": "r067",
      "kind": "math",
      "x": 40,
      "y": 5712,
      "src": "F_n150 := 470 MPa = kgf/cm^2"
    },
    {
      "id": "r068",
      "kind": "math",
      "x": 40,
      "y": 5760,
      "src": "Rd_b490 := 0.75*F_n150*A_b = tonf"
    },
    {
      "id": "r069",
      "kind": "math",
      "x": 40,
      "y": 5808,
      "src": "u_e490 := r_b/Rd_b490 ="
    },
    {
      "id": "v_e490",
      "kind": "math",
      "x": 40,
      "y": 5856,
      "src": "r_b <= Rd_b490 ="
    },
    {
      "id": "s119",
      "kind": "text",
      "x": 40,
      "y": 5920,
      "src": "━━ 8 · FRONTERA DEL EJEMPLO, DECLARADA: EL APOYO EN EL ALMA DE LA VIGA ━━",
      "pageBreak": true
    },
    {
      "id": "t120",
      "kind": "text",
      "x": 40,
      "y": 5968,
      "src": "El alma es continua alrededor de los pernos: no hay desgarre al borde, los 4 quedan por aplastamiento (J3-6a)"
    },
    {
      "id": "r070",
      "kind": "math",
      "x": 40,
      "y": 6016,
      "src": "Rd_alm := 0.75*n_b*2.4*d_b*t_w*F_uv = tonf"
    },
    {
      "id": "r071",
      "kind": "math",
      "x": 40,
      "y": 6064,
      "src": "u_alm := V_u/Rd_alm ="
    },
    {
      "id": "t123",
      "kind": "text",
      "x": 40,
      "y": 6112,
      "src": "Fuera de alcance y NO calculadas acá: la soldadura plancha-columna (que además recibe M_u) y el pandeo de la plancha"
    },
    {
      "id": "s124",
      "kind": "text",
      "x": 40,
      "y": 6176,
      "src": "━━ 9 · USOS ━━"
    },
    {
      "id": "r072",
      "kind": "math",
      "x": 40,
      "y": 6224,
      "src": "u_cad := max(u_per, u_grp, u_apo, u_pfl, u_pro, u_bc) ="
    },
    {
      "id": "v_cad",
      "kind": "math",
      "x": 40,
      "y": 6272,
      "src": "u_cad <= 1 ="
    },
