{
  "version": 1,
  "meta": {
    "titulo": "Viga de hormigón armado a flexión y corte — el Cap. 9 completo, con los coeficientes de la edición SI de ACI 318-25",
    "ficha": "struct_pad/src/content/hormigon/ejemplo-viga-flexion-corte.mdx",
    "esperadoFalso": {}
  },
  "regions": [
    {
      "id": "r000",
      "kind": "text",
      "x": 40,
      "y": 32,
      "src": "VIGA DE HORMIGÓN ARMADO A FLEXIÓN Y CORTE — el caso canónico del Cap. 9"
    },
    {
      "id": "r001",
      "kind": "text",
      "x": 40,
      "y": 80,
      "src": "ACI 318-25 (edición SI) · Cap. 9 + 22.2/22.3 (flexión) + 22.5 (corte) · Tablas 21.2.1 y 21.2.2"
    },
    {
      "id": "r002",
      "kind": "text",
      "x": 40,
      "y": 128,
      "src": "Rd_ = capacidad de diseño (incluye phi) · las comparaciones dan ✓/✗"
    },
    {
      "id": "r003",
      "kind": "text",
      "x": 40,
      "y": 176,
      "src": ""
    },
    {
      "id": "r004",
      "kind": "text",
      "x": 40,
      "y": 192,
      "src": "Coeficientes empíricos: edición SI, en MPa. Las equivalencias en kgf/cm², en §5."
    },
    {
      "id": "r008",
      "kind": "text",
      "x": 40,
      "y": 256,
      "src": "━━ DATOS · MATERIALES ━━"
    },
    {
      "id": "r009",
      "kind": "text",
      "x": 40,
      "y": 304,
      "src": "f'c y f_y son frontera declarada; todo lo demás se deriva."
    },
    {
      "id": "r011",
      "kind": "math",
      "x": 40,
      "y": 352,
      "src": "f_c := 250 kgf/cm^2"
    },
    {
      "id": "r012",
      "kind": "math",
      "x": 40,
      "y": 400,
      "src": "f_y := 4200 kgf/cm^2"
    },
    {
      "id": "r013",
      "kind": "math",
      "x": 40,
      "y": 448,
      "src": "f_yt := f_y"
    },
    {
      "id": "r014",
      "kind": "text",
      "x": 40,
      "y": 496,
      "src": "El radicando de las expresiones de corte va en MPa (edición SI):"
    },
    {
      "id": "r015",
      "kind": "math",
      "x": 40,
      "y": 544,
      "src": "f_cM := f_c = MPa"
    },
    {
      "id": "r016",
      "kind": "math",
      "x": 40,
      "y": 592,
      "src": "rfc := sqrt(f_c/MPa)*MPa = MPa"
    },
    {
      "id": "r017",
      "kind": "text",
      "x": 40,
      "y": 640,
      "src": "20.2.2.2: se permite tomar E_s = 200 000 MPa para barras no pretensadas."
    },
    {
      "id": "r018",
      "kind": "math",
      "x": 40,
      "y": 688,
      "src": "E_s := 200000 MPa"
    },
    {
      "id": "r019",
      "kind": "math",
      "x": 40,
      "y": 736,
      "src": "eps_ty := f_y/E_s ="
    },
    {
      "id": "r020",
      "kind": "text",
      "x": 40,
      "y": 784,
      "src": "19.2.4.2: hormigón de densidad normal → λ = 1"
    },
    {
      "id": "r021",
      "kind": "math",
      "x": 40,
      "y": 832,
      "src": "lam := 1"
    },
    {
      "id": "r022",
      "kind": "text",
      "x": 40,
      "y": 880,
      "src": "22.2.2.1: deformación útil máxima del hormigón en compresión"
    },
    {
      "id": "r023",
      "kind": "math",
      "x": 40,
      "y": 928,
      "src": "eps_cu := 0.003"
    },
    {
      "id": "r024",
      "kind": "text",
      "x": 40,
      "y": 976,
      "src": "Tabla 22.2.2.4.3(a): β1 = 0,85 para 17 ≤ f'c ≤ 28 MPa"
    },
    {
      "id": "r025",
      "kind": "math",
      "x": 40,
      "y": 1024,
      "src": "beta_1 := beta1(f_c) ="
    },
    {
      "id": "v_b1",
      "kind": "math",
      "x": 40,
      "y": 1072,
      "src": "v_b1 := f_cM >= 17 MPa and f_cM <= 28 MPa ="
    },
    {
      "id": "r027",
      "kind": "text",
      "x": 40,
      "y": 1136,
      "src": "━━ DATOS · FACTORES φ ━━"
    },
    {
      "id": "r028",
      "kind": "text",
      "x": 40,
      "y": 1184,
      "src": "Tabla 21.2.2(f): φ = 0,90 si es controlada por tracción (se verifica en §2.1)."
    },
    {
      "id": "r029",
      "kind": "math",
      "x": 40,
      "y": 1232,
      "src": "phi_f := 0.90"
    },
    {
      "id": "r030",
      "kind": "text",
      "x": 40,
      "y": 1280,
      "src": "Tabla 21.2.1: φ = 0,75 para cortante."
    },
    {
      "id": "r031",
      "kind": "math",
      "x": 40,
      "y": 1328,
      "src": "phi_v := 0.75"
    },
    {
      "id": "r032",
      "kind": "text",
      "x": 40,
      "y": 1392,
      "src": "━━ DATOS · GEOMETRÍA Y ARMADURA ━━"
    },
    {
      "id": "r033",
      "kind": "math",
      "x": 40,
      "y": 1440,
      "src": "b_w := 30 cm"
    },
    {
      "id": "r034",
      "kind": "math",
      "x": 40,
      "y": 1488,
      "src": "h := 60 cm"
    },
    {
      "id": "r035",
      "kind": "math",
      "x": 40,
      "y": 1536,
      "src": "L := 6.0 m"
    },
    {
      "id": "r036",
      "kind": "text",
      "x": 40,
      "y": 1584,
      "src": "Tabla 20.5.1.3.1: viga no expuesta → recubrimiento 40 mm, a la cara del estribo."
    },
    {
      "id": "r038",
      "kind": "math",
      "x": 40,
      "y": 1632,
      "src": "rec := 40 mm"
    },
    {
      "id": "r039",
      "kind": "math",
      "x": 40,
      "y": 1680,
      "src": "d_e := 10 mm"
    },
    {
      "id": "r040",
      "kind": "math",
      "x": 40,
      "y": 1728,
      "src": "d_b := 25 mm"
    },
    {
      "id": "r041",
      "kind": "math",
      "x": 40,
      "y": 1776,
      "src": "n_b := 3"
    },
    {
      "id": "r042",
      "kind": "text",
      "x": 40,
      "y": 1824,
      "src": "Frontera declarada: el área NOMINAL de la barra. A_s, d y b·d se derivan."
    },
    {
      "id": "r043",
      "kind": "math",
      "x": 40,
      "y": 1872,
      "src": "A_b := pi/4*d_b^2 = cm^2"
    },
    {
      "id": "r044",
      "kind": "math",
      "x": 40,
      "y": 1920,
      "src": "A_s := n_b*A_b = cm^2"
    },
    {
      "id": "r045",
      "kind": "text",
      "x": 40,
      "y": 1968,
      "src": "Altura útil: se DERIVA de la disposición de barras, no se declara."
    },
    {
      "id": "r046",
      "kind": "math",
      "x": 40,
      "y": 2016,
      "src": "d := h - rec - d_e - d_b/2 = cm"
    },
    {
      "id": "r047",
      "kind": "text",
      "x": 40,
      "y": 2064,
      "src": "25.2.1: separación libre ≥ la mayor de 25 mm, d_b y 4/3 d_agg (una capa)."
    },
    {
      "id": "r048",
      "kind": "math",
      "x": 40,
      "y": 2112,
      "src": "s_libre := (b_w - 2*rec - 2*d_e - n_b*d_b)/(n_b - 1) = mm"
    },
    {
      "id": "v_sep",
      "kind": "math",
      "x": 40,
      "y": 2160,
      "src": "v_sep := s_libre >= max(25 mm, d_b) ="
    },
    {
      "id": "r050",
      "kind": "text",
      "x": 40,
      "y": 2224,
      "src": "━━ CARGAS Y SOLICITACIONES ━━"
    },
    {
      "id": "r051",
      "kind": "math",
      "x": 40,
      "y": 2272,
      "src": "D := 3.0 tonf/m"
    },
    {
      "id": "r052",
      "kind": "math",
      "x": 40,
      "y": 2320,
      "src": "L_v := 1.5 tonf/m"
    },
    {
      "id": "r053",
      "kind": "text",
      "x": 40,
      "y": 2368,
      "src": "Tabla 5.3.1, Ec. (5.3.1b): U = 1,2D + 1,6L + (0,5L_r ó 0,3S ó 0,5R), nulos acá."
    },
    {
      "id": "r054",
      "kind": "math",
      "x": 40,
      "y": 2416,
      "src": "w_u := 1.2*D + 1.6*L_v = tonf/m"
    },
    {
      "id": "r055",
      "kind": "math",
      "x": 40,
      "y": 2464,
      "src": "M_u := w_u*L^2/8 = tonf*m"
    },
    {
      "id": "r056",
      "kind": "math",
      "x": 40,
      "y": 2512,
      "src": "V_uap := w_u*L/2 = tonf"
    },
    {
      "id": "r057",
      "kind": "text",
      "x": 40,
      "y": 2560,
      "src": "9.4.3.2: sección crítica de corte a d de la cara; sin ancho de apoyo declarado, desde el eje."
    },
    {
      "id": "r061",
      "kind": "math",
      "x": 40,
      "y": 2608,
      "src": "V_ud := w_u*(L/2 - d) = tonf"
    },
    {
      "id": "r062",
      "kind": "text",
      "x": 40,
      "y": 2672,
      "src": "━━ 1 · ALTURA MÍNIMA SIN CALCULAR DEFLEXIONES (Tabla 9.3.1.1) ━━"
    },
    {
      "id": "r063",
      "kind": "text",
      "x": 40,
      "y": 2720,
      "src": "Simplemente apoyada → h_min = ℓ/16 (nota [1]: densidad normal, Grado 420)."
    },
    {
      "id": "r065",
      "kind": "math",
      "x": 40,
      "y": 2768,
      "src": "h_min := L/16 = cm"
    },
    {
      "id": "v_h",
      "kind": "math",
      "x": 40,
      "y": 2816,
      "src": "v_h := h >= h_min ="
    },
    {
      "id": "r067",
      "kind": "math",
      "x": 40,
      "y": 2864,
      "src": "u_h := h_min/h ="
    },
    {
      "id": "r068",
      "kind": "text",
      "x": 40,
      "y": 2928,
      "src": "━━ 2 · FLEXIÓN — BLOQUE RECTANGULAR EQUIVALENTE (22.2.2.4) ━━"
    },
    {
      "id": "r069",
      "kind": "text",
      "x": 40,
      "y": 2976,
      "src": "22.2.2.4.1: compresión uniforme de 0,85f'c sobre una altura a = β1·c."
    },
    {
      "id": "r070",
      "kind": "math",
      "x": 40,
      "y": 3024,
      "src": "a := A_s*f_y/(0.85*f_c*b_w) = cm"
    },
    {
      "id": "r071",
      "kind": "math",
      "x": 40,
      "y": 3072,
      "src": "c := a/beta_1 = cm"
    },
    {
      "id": "r072",
      "kind": "text",
      "x": 40,
      "y": 3120,
      "src": "22.2.1.2 + Fig. R21.2.2a: ε_t por compatibilidad de deformaciones."
    },
    {
      "id": "r073",
      "kind": "math",
      "x": 40,
      "y": 3168,
      "src": "eps_t := eps_cu*(d - c)/c ="
    },
    {
      "id": "r074",
      "kind": "math",
      "x": 40,
      "y": 3216,
      "src": "cdt := c/d ="
    },
    {
      "id": "r075",
      "kind": "text",
      "x": 40,
      "y": 3280,
      "src": "━━ 2.1 · DUCTILIDAD: ¿CONTROLADA POR TRACCIÓN? (9.3.3.1 + Tabla 21.2.2) ━━"
    },
    {
      "id": "r076",
      "kind": "text",
      "x": 40,
      "y": 3328,
      "src": "9.3.3.1: una viga con P_u < 0,10f'c·A_g debe ser controlada por tracción."
    },
    {
      "id": "r077",
      "kind": "math",
      "x": 40,
      "y": 3376,
      "src": "eps_lim := eps_ty + 0.003 ="
    },
    {
      "id": "v_duct",
      "kind": "math",
      "x": 40,
      "y": 3424,
      "src": "v_duct := eps_t >= eps_lim ="
    },
    {
      "id": "r079",
      "kind": "text",
      "x": 40,
      "y": 3472,
      "src": "El φ que sale de la Tabla 21.2.2 con ese ε_t, contra el φ = 0,90 supuesto:"
    },
    {
      "id": "r080",
      "kind": "math",
      "x": 40,
      "y": 3520,
      "src": "phi_chk := phiFlexion(eps_t, eps_ty) ="
    },
    {
      "id": "v_phi",
      "kind": "math",
      "x": 40,
      "y": 3568,
      "src": "v_phi := phi_chk == phi_f ="
    },
    {
      "id": "r082",
      "kind": "text",
      "x": 40,
      "y": 3616,
      "src": "El mismo límite en forma geométrica: c/d_t ≤ ε_cu/(ε_cu + ε_lim)."
    },
    {
      "id": "r083",
      "kind": "math",
      "x": 40,
      "y": 3664,
      "src": "cdt_lim := eps_cu/(eps_cu + eps_lim) ="
    },
    {
      "id": "v_cdt",
      "kind": "math",
      "x": 40,
      "y": 3712,
      "src": "v_cdt := cdt <= cdt_lim ="
    },
    {
      "id": "r085",
      "kind": "text",
      "x": 40,
      "y": 3776,
      "src": "━━ 2.2 · RESISTENCIA A FLEXIÓN (22.3.1) Y CONDICIÓN 9.5.1.1(a) ━━"
    },
    {
      "id": "r086",
      "kind": "text",
      "x": 40,
      "y": 3824,
      "src": "9.5.1.1(a): φM_n ≥ M_u  (no 9.3.2.1, que son los límites de deflexión)."
    },
    {
      "id": "r088",
      "kind": "math",
      "x": 40,
      "y": 3872,
      "src": "M_n := A_s*f_y*(d - a/2) = tonf*m"
    },
    {
      "id": "r089",
      "kind": "math",
      "x": 40,
      "y": 3920,
      "src": "Rd_M := phi_f*M_n = tonf*m"
    },
    {
      "id": "v_M",
      "kind": "math",
      "x": 40,
      "y": 3968,
      "src": "v_M := Rd_M >= M_u ="
    },
    {
      "id": "r091",
      "kind": "math",
      "x": 40,
      "y": 4016,
      "src": "u_M := M_u/Rd_M ="
    },
    {
      "id": "r092",
      "kind": "text",
      "x": 40,
      "y": 4080,
      "src": "━━ 2.3 · REFUERZO MÍNIMO A FLEXIÓN (9.6.1.2) ━━"
    },
    {
      "id": "r093",
      "kind": "text",
      "x": 40,
      "y": 4128,
      "src": "A_s,min = el mayor de (a) 0,25√f'c/f_y·b_w·d y (b) 1,4/f_y·b_w·d, en MPa."
    },
    {
      "id": "r094",
      "kind": "math",
      "x": 40,
      "y": 4176,
      "src": "rho_a := 0.25*rfc/f_y ="
    },
    {
      "id": "r095",
      "kind": "math",
      "x": 40,
      "y": 4224,
      "src": "rho_b := 1.4 MPa/f_y ="
    },
    {
      "id": "r096",
      "kind": "math",
      "x": 40,
      "y": 4272,
      "src": "A_smin := max(rho_a, rho_b)*b_w*d = cm^2"
    },
    {
      "id": "v_Asmin",
      "kind": "math",
      "x": 40,
      "y": 4320,
      "src": "v_Asmin := A_s >= A_smin ="
    },
    {
      "id": "r098",
      "kind": "text",
      "x": 40,
      "y": 4368,
      "src": "Gobierna el término (b), el piso para hormigones corrientes:"
    },
    {
      "id": "v_gob",
      "kind": "math",
      "x": 40,
      "y": 4416,
      "src": "v_gob := rho_b > rho_a ="
    },
    {
      "id": "r100",
      "kind": "text",
      "x": 40,
      "y": 4480,
      "src": "━━ 3 · CORTE — APORTE DEL HORMIGÓN (Tabla 22.5.5.1) ━━"
    },
    {
      "id": "r101",
      "kind": "text",
      "x": 40,
      "y": 4528,
      "src": "Tabla 22.5.5.1 fila 1, opción (a): V_c = [0,17λ√f'c + N_u/(6A_g)]·b_w·d, con N_u = 0."
    },
    {
      "id": "r103",
      "kind": "math",
      "x": 40,
      "y": 4576,
      "src": "V_c := 0.17*lam*rfc*b_w*d = tonf"
    },
    {
      "id": "r104",
      "kind": "math",
      "x": 40,
      "y": 4624,
      "src": "Rd_Vc := phi_v*V_c = tonf"
    },
    {
      "id": "r105",
      "kind": "text",
      "x": 40,
      "y": 4672,
      "src": "22.5.5.1.1: V_c ≤ 0,42λ√f'c·b_w·d y V_c ≥ 0,083λ√f'c·b_w·d."
    },
    {
      "id": "r106",
      "kind": "math",
      "x": 40,
      "y": 4720,
      "src": "V_ctop := 0.42*lam*rfc*b_w*d = tonf"
    },
    {
      "id": "r107",
      "kind": "math",
      "x": 40,
      "y": 4768,
      "src": "V_cpiso := 0.083*lam*rfc*b_w*d = tonf"
    },
    {
      "id": "v_Vcrango",
      "kind": "math",
      "x": 40,
      "y": 4816,
      "src": "v_Vcrango := V_c <= V_ctop and V_c >= V_cpiso ="
    },
    {
      "id": "r109",
      "kind": "text",
      "x": 40,
      "y": 4864,
      "src": "9.6.3.1: se exige A_v,min donde V_u > φ·0,083λ√f'c·b_w·d."
    },
    {
      "id": "r112",
      "kind": "math",
      "x": 40,
      "y": 4912,
      "src": "V_trig := phi_v*V_cpiso = tonf"
    },
    {
      "id": "v_trig",
      "kind": "math",
      "x": 40,
      "y": 4960,
      "src": "v_trig := V_ud > V_trig ="
    },
    {
      "id": "r114",
      "kind": "text",
      "x": 40,
      "y": 5008,
      "src": "Y como además V_u@d > φV_c, los estribos tienen que tomar el resto:"
    },
    {
      "id": "v_estribos",
      "kind": "math",
      "x": 40,
      "y": 5056,
      "src": "v_estribos := V_ud > Rd_Vc ="
    },
    {
      "id": "r116",
      "kind": "text",
      "x": 40,
      "y": 5120,
      "src": "━━ 3.1 · ESTRIBOS REQUERIDOS (22.5.8.1 y Ec. 22.5.8.5.3) ━━"
    },
    {
      "id": "r117",
      "kind": "text",
      "x": 40,
      "y": 5168,
      "src": "22.5.8.1: donde V_u > φV_c, V_s ≥ V_u/φ − V_c  (era 22.5.10 en 318-19)."
    },
    {
      "id": "r119",
      "kind": "math",
      "x": 40,
      "y": 5216,
      "src": "V_sreq := V_ud/phi_v - V_c = tonf"
    },
    {
      "id": "r120",
      "kind": "text",
      "x": 40,
      "y": 5264,
      "src": "22.5.1.2: V_u ≤ φ(V_c + 0,66λ√f'c·b_w·d) — el tope de la biela comprimida del alma."
    },
    {
      "id": "r122",
      "kind": "math",
      "x": 40,
      "y": 5312,
      "src": "V_stop := 0.66*lam*rfc*b_w*d = tonf"
    },
    {
      "id": "r123",
      "kind": "math",
      "x": 40,
      "y": 5360,
      "src": "V_umax := phi_v*(V_c + V_stop) = tonf"
    },
    {
      "id": "v_biela",
      "kind": "math",
      "x": 40,
      "y": 5408,
