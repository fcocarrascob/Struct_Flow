   "kind": "math",
   "x": 40,
   "y": 14384,
   "src": "abs(lam_rf - 13.5) < 0.05 ="
  },
  {
   "id": "c_lamrw",
   "kind": "math",
   "x": 40,
   "y": 14432,
   "src": "abs(lam_rw - 35.9) < 0.05 ="
  },
  {
   "id": "c_lampf",
   "kind": "math",
   "x": 40,
   "y": 14480,
   "src": "abs(lam_pf - 9.15) < 0.005 ="
  },
  {
   "id": "c_lampw",
   "kind": "math",
   "x": 40,
   "y": 14528,
   "src": "abs(lam_pw - 90.5) < 0.05 ="
  },
  {
   "id": "c_lamx",
   "kind": "math",
   "x": 40,
   "y": 14576,
   "src": "abs(lam_x - 64.8) < 0.05 ="
  },
  {
   "id": "c_lamy",
   "kind": "math",
   "x": 40,
   "y": 14624,
   "src": "abs(lam_yA - 69.6) < 0.05 ="
  },
  {
   "id": "c_lamy2",
   "kind": "math",
   "x": 40,
   "y": 14672,
   "src": "abs(lam_yA - 69.58) < 0.005 ="
  },
  {
   "id": "c_fea",
   "kind": "math",
   "x": 40,
   "y": 14720,
   "src": "abs(F_eA - 4158 kgf/cm^2) < 0.5 kgf/cm^2 ="
  },
  {
   "id": "c_qa",
   "kind": "math",
   "x": 40,
   "y": 14768,
   "src": "abs(q_A - 0.846) < 0.0005 ="
  },
  {
   "id": "c_fna",
   "kind": "math",
   "x": 40,
   "y": 14816,
   "src": "abs(F_nA - 2470 kgf/cm^2) < 0.5 kgf/cm^2 ="
  },
  {
   "id": "c_rdpakgf",
   "kind": "math",
   "x": 40,
   "y": 14864,
   "src": "abs(Rd_PA - 164947 kgf) < 0.5 kgf ="
  },
  {
   "id": "c_rdpa",
   "kind": "math",
   "x": 40,
   "y": 14912,
   "src": "abs(Rd_PA - 164.9 tonf) < 0.05 tonf ="
  },
  {
   "id": "c_upa",
   "kind": "math",
   "x": 40,
   "y": 14960,
   "src": "abs(u_PA - 0.55) < 0.005 ="
  },
  {
   "id": "c_lp",
   "kind": "math",
   "x": 40,
   "y": 15008,
   "src": "abs(L_p - 2.13 m) < 0.005 m ="
  },
  {
   "id": "c_lr",
   "kind": "math",
   "x": 40,
   "y": 15056,
   "src": "abs(L_r - 7.38 m) < 0.005 m ="
  },
  {
   "id": "c_cba",
   "kind": "math",
   "x": 40,
   "y": 15104,
   "src": "abs(C_bA - 1.30) < 0.005 ="
  },
  {
   "id": "c_cba3",
   "kind": "math",
   "x": 40,
   "y": 15152,
   "src": "abs(C_bA - 1.299) < 0.0005 ="
  },
  {
   "id": "c_mpkgf",
   "kind": "math",
   "x": 40,
   "y": 15200,
   "src": "abs(M_p - 2699840 kgf*cm) < 0.5 kgf*cm ="
  },
  {
   "id": "c_mp",
   "kind": "math",
   "x": 40,
   "y": 15248,
   "src": "abs(M_p - 27.0 tonf*m) < 0.05 tonf*m ="
  },
  {
   "id": "c_mn0a",
   "kind": "math",
   "x": 40,
   "y": 15296,
   "src": "abs(Mn0_A - 31.7 tonf*m) < 0.05 tonf*m ="
  },
  {
   "id": "c_rdma",
   "kind": "math",
   "x": 40,
   "y": 15344,
   "src": "abs(Rd_MA - 24.3 tonf*m) < 0.05 tonf*m ="
  },
  {
   "id": "c_uma1",
   "kind": "math",
   "x": 40,
   "y": 15392,
   "src": "abs(u_MA1 - 0.33) < 0.005 ="
  },
  {
   "id": "c_pe1kgf",
   "kind": "math",
   "x": 40,
   "y": 15440,
   "src": "abs(P_e1 - 357481 kgf) < 0.5 kgf ="
  },
  {
   "id": "c_pe1",
   "kind": "math",
   "x": 40,
   "y": 15488,
   "src": "abs(P_e1 - 357 tonf) < 0.5 tonf ="
  },
  {
   "id": "c_ratio",
   "kind": "math",
   "x": 40,
   "y": 15536,
   "src": "abs(ratio - 0.25) < 0.005 ="
  },
  {
   "id": "c_b1",
   "kind": "math",
   "x": 40,
   "y": 15584,
   "src": "abs(B_1 - 1.34) < 0.005 ="
  },
  {
   "id": "c_infla",
   "kind": "math",
   "x": 40,
   "y": 15632,
   "src": "abs(infla - 34) < 0.5 ="
  },
  {
   "id": "c_mr",
   "kind": "math",
   "x": 40,
   "y": 15680,
   "src": "abs(M_r - 10.7 tonf*m) < 0.05 tonf*m ="
  },
  {
   "id": "c_uma",
   "kind": "math",
   "x": 40,
   "y": 15728,
   "src": "abs(u_MA - 0.44) < 0.005 ="
  },
  {
   "id": "c_ua",
   "kind": "math",
   "x": 40,
   "y": 15776,
   "src": "abs(u_A - 0.94) < 0.005 ="
  },
  {
   "id": "c_usinb1",
   "kind": "math",
   "x": 40,
   "y": 15824,
   "src": "abs(u_sinB1 - 0.84) < 0.005 ="
  },
  {
   "id": "c_difb1",
   "kind": "math",
   "x": 40,
   "y": 15872,
   "src": "abs(dif_B1 - 0.10) < 0.005 ="
  },
  {
   "id": "c_usuma",
   "kind": "math",
   "x": 40,
   "y": 15920,
   "src": "abs(u_suma - 0.99) < 0.005 ="
  },
  {
   "id": "c_lamyb",
   "kind": "math",
   "x": 40,
   "y": 15968,
   "src": "abs(lam_yB - 139) < 0.5 ="
  },
  {
   "id": "c_rdpb",
   "kind": "math",
   "x": 40,
   "y": 16016,
   "src": "abs(Rd_PB - 60.9 tonf) < 0.05 tonf ="
  },
  {
   "id": "c_cbb",
   "kind": "math",
   "x": 40,
   "y": 16064,
   "src": "abs(C_bB - 1.14) < 0.005 ="
  },
  {
   "id": "c_rdmb",
   "kind": "math",
   "x": 40,
   "y": 16112,
   "src": "abs(Rd_MB - 18.1 tonf*m) < 0.05 tonf*m ="
  },
  {
   "id": "c_ub",
   "kind": "math",
   "x": 40,
   "y": 16160,
   "src": "abs(u_B - 2.0) < 0.05 ="
  }
 ]
