    {
      "id": "r096",
      "kind": "math",
      "x": 40,
      "y": 5568,
      "src": "K_g := 1.2"
    },
    {
      "id": "r097",
      "kind": "text",
      "x": 40,
      "y": 5616,
      "src": "K declarado, no derivado: supone el borde libre desplazándose (lado conservador)"
    },
    {
      "id": "r098",
      "kind": "math",
      "x": 40,
      "y": 5664,
      "src": "L_lib := t_sec = cm"
    },
    {
      "id": "r099",
      "kind": "math",
      "x": 40,
      "y": 5712,
      "src": "r_g := t_g/sqrt(12) = cm"
    },
    {
      "id": "r100",
      "kind": "math",
      "x": 40,
      "y": 5760,
      "src": "esb := K_g*L_lib/r_g ="
    },
    {
      "id": "r101",
      "kind": "program",
      "x": 40,
      "y": 5808,
      "src": "F_cr :=\n    if esb <= 25\n        return F_y\n    lim := 4.71*sqrt(E/F_y)\n    F_e := pi^2*E/esb^2\n    if esb <= lim\n        return 0.658^(F_y/F_e)*F_y\n    return 0.877*F_e"
    },
    {
      "id": "r102",
      "kind": "math",
      "x": 40,
      "y": 5984,
      "src": "F_cr = kgf/cm^2"
    },
    {
      "id": "r103",
      "kind": "math",
      "x": 40,
      "y": 6032,
      "src": "Rd_pan := 0.90*F_cr*w_c*t_g = tonf"
    },
    {
      "id": "v_pan",
      "kind": "math",
      "x": 40,
      "y": 6080,
      "src": "Rd_pan >= T_r ="
    },
    {
      "id": "r104",
      "kind": "text",
      "x": 40,
      "y": 6128,
      "src": "La pinza: la rama compacta J4-6 pediría este espesor de plancha, y hay 20 mm"
    },
    {
      "id": "r105",
      "kind": "math",
      "x": 40,
      "y": 6176,
      "src": "t_J46 := w_t*K_g*sqrt(12)/50 = cm"
    },
    {
      "id": "v_pinza",
      "kind": "math",
      "x": 40,
      "y": 6224,
      "src": "t_J46 > t_g ="
    },
    {
      "id": "r106",
      "kind": "math",
      "x": 40,
      "y": 6272,
      "src": "pier := 0.8 cm"
    },
    {
      "id": "r107",
      "kind": "text",
      "x": 40,
      "y": 6336,
      "src": "━━ 8 · INTERFAZ CON EL ALA (J2.4 + Ec. J4-3) ━━"
    },
    {
      "id": "r108",
      "kind": "math",
      "x": 40,
      "y": 6384,
      "src": "Rd_sol := 0.75*0.6*F_EXX*(pier/sqrt(2))*b_sup*2 = tonf"
    },
    {
      "id": "v_sol",
      "kind": "math",
      "x": 40,
      "y": 6432,
      "src": "Rd_sol >= T_r ="
    },
    {
      "id": "r109",
      "kind": "text",
      "x": 40,
      "y": 6480,
      "src": "Y la plancha misma sobre su sección de borde — en el gusset del ápice ESTO gobernaba"
    },
    {
      "id": "r110",
      "kind": "math",
      "x": 40,
      "y": 6528,
      "src": "A_bo := b_sup*t_g = cm^2"
    },
    {
      "id": "r111",
      "kind": "math",
      "x": 40,
      "y": 6576,
      "src": "Rd_vb := 1.00*0.6*F_y*A_bo = tonf"
    },
    {
      "id": "v_vb",
      "kind": "math",
      "x": 40,
      "y": 6624,
      "src": "Rd_vb >= V_i ="
    },
    {
      "id": "r112",
      "kind": "math",
      "x": 40,
      "y": 6672,
      "src": "sig_b := N_i/A_bo = kgf/cm^2"
    },
    {
      "id": "r113",
      "kind": "math",
      "x": 40,
      "y": 6720,
      "src": "tau_b := V_i/A_bo = kgf/cm^2"
    },
    {
      "id": "r114",
      "kind": "math",
      "x": 40,
      "y": 6768,
      "src": "u_vm := sqrt(sig_b^2 + 3*tau_b^2)/(0.90*F_y) ="
    },
    {
      "id": "v_vm",
      "kind": "math",
      "x": 40,
      "y": 6816,
      "src": "u_vm <= 1 ="
    },
    {
      "id": "r115",
      "kind": "text",
      "x": 40,
      "y": 6880,
      "src": "━━ 9 · USOS ━━",
