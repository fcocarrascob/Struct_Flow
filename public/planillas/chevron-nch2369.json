      "y": 224,
      "src": "de las columnas al centro de la viga superior, que es parte de una plataforma de operación."
    },
    {
      "id": "r005",
      "kind": "text",
      "x": 40,
      "y": 288,
      "src": "━━ DATOS · ACERO Y FACTORES ━━"
    },
    {
      "id": "r006",
      "kind": "text",
      "x": 40,
      "y": 336,
      "src": "ASTM A36. El R_y = 1,30 es el valor nacional de C8.3.3, no el 1,5 de AISC 341."
    },
    {
      "id": "r007",
      "kind": "math",
      "x": 40,
      "y": 384,
      "src": "F_y := 2530 kgf/cm^2"
    },
    {
      "id": "r008",
      "kind": "math",
      "x": 40,
      "y": 432,
      "src": "E := 2039000 kgf/cm^2"
    },
    {
      "id": "r009",
      "kind": "math",
      "x": 40,
      "y": 480,
      "src": "R_y := 1.30"
    },
    {
      "id": "r010",
      "kind": "math",
      "x": 40,
      "y": 528,
      "src": "F_ye := R_y*F_y = kgf/cm^2"
    },
    {
      "id": "r011",
      "kind": "math",
      "x": 40,
      "y": 576,
      "src": "phi := 0.90"
    },
    {
      "id": "r012",
      "kind": "text",
      "x": 40,
      "y": 640,
      "src": "━━ DATOS · GEOMETRÍA DEL PAÑO Y ANÁLISIS ━━"
    },
    {
      "id": "r013",
      "kind": "text",
      "x": 40,
      "y": 688,
      "src": "Del análisis, nivel reducido por R: axial de la diagonal P_E y gravedad sobre la viga w."
    },
    {
      "id": "r014",
      "kind": "math",
      "x": 40,
      "y": 736,
      "src": "L := 8.00 m"
    },
    {
      "id": "r015",
      "kind": "math",
      "x": 40,
      "y": 784,
      "src": "H := 4.00 m"
    },
    {
      "id": "r016",
      "kind": "math",
      "x": 40,
      "y": 832,
      "src": "w := 1.5 tonf/m"
    },
    {
      "id": "r017",
      "kind": "math",
      "x": 40,
      "y": 880,
      "src": "P_E := 36.0 tonf"
    },
    {
      "id": "r018",
      "kind": "math",
      "x": 40,
      "y": 928,
      "src": "R_1 := 4.0"
    },
    {
      "id": "r019",
      "kind": "math",
      "x": 40,
      "y": 976,
      "src": "L_b := 2.0 m"
    },
    {
      "id": "r020",
      "kind": "text",
      "x": 40,
      "y": 1024,
      "src": "La diagonal y su ángulo salen de la geometría, no se declaran:"
    },
    {
      "id": "r021",
      "kind": "math",
      "x": 40,
      "y": 1072,
      "src": "L_d := sqrt((L/2)^2 + H^2) = m"
    },
    {
      "id": "r022",
      "kind": "math",
      "x": 40,
      "y": 1120,
      "src": "alf := atan(H/(L/2))"
    },
    {
      "id": "r023",
      "kind": "math",
      "x": 40,
      "y": 1168,
      "src": "grados := alf*180/pi ="
    },
    {
      "id": "r024",
      "kind": "math",
      "x": 40,
      "y": 1216,
      "src": "Q := 2*P_E*cos(alf) = tonf"
    },
    {
      "id": "r025",
      "kind": "text",
      "x": 40,
      "y": 1280,
      "src": "━━ DATOS · DIAGONAL, CAJÓN SOLDADO DE 4 PLANCHAS [] 200×200×10 ━━"
    },
    {
      "id": "r026",
      "kind": "text",
      "x": 40,
      "y": 1328,
      "src": "Sección soldada: el área, la inercia y el radio de giro salen de las planchas."
    },
    {
      "id": "r027",
      "kind": "math",
      "x": 40,
      "y": 1376,
      "src": "B_d := 20 cm"
    },
    {
      "id": "r028",
      "kind": "math",
      "x": 40,
      "y": 1424,
      "src": "t_d := 1.0 cm"
    },
    {
      "id": "r029",
      "kind": "math",
      "x": 40,
      "y": 1472,
      "src": "A_d := B_d^2 - (B_d - 2*t_d)^2 = cm^2"
    },
    {
      "id": "r030",
      "kind": "math",
      "x": 40,
      "y": 1520,
      "src": "I_d := (B_d^4 - (B_d - 2*t_d)^4)/12 = cm^4"
    },
    {
      "id": "r031",
      "kind": "math",
      "x": 40,
      "y": 1568,
      "src": "r_d := sqrt(I_d/A_d) = cm"
    },
    {
      "id": "r032",
      "kind": "math",
      "x": 40,
      "y": 1616,
      "src": "bt_d := (B_d - 2*t_d)/t_d ="
    },
    {
      "id": "r033",
      "kind": "text",
      "x": 40,
      "y": 1680,
      "src": "━━ 1 · LA DIAGONAL NO ES LIBRE (8.6.3 + Tabla 9) ━━"
    },
    {
      "id": "r034",
      "kind": "text",
      "x": 40,
      "y": 1728,
      "src": "Tabla 9, elementos atiesados: paredes de perfiles rectangulares soldados usados como"
    },
    {
      "id": "r035",
      "kind": "text",
      "x": 40,
      "y": 1776,
      "src": "arriostramientos → lam_md = 0,76·raíz(E/(R_y·F_y)). Con F_ye ya calculado es lo mismo."
    },
    {
      "id": "r036",
      "kind": "math",
      "x": 40,
      "y": 1824,
      "src": "lam_md := 0.76*sqrt(E/F_ye) ="
    },
    {
      "id": "v_btd",
      "kind": "math",
      "x": 40,
      "y": 1872,
      "src": "bt_d <= lam_md ="
    },
    {
      "id": "r038",
      "kind": "math",
      "x": 40,
      "y": 1920,
      "src": "u_btd := bt_d/lam_md ="
    },
    {
      "id": "r039",
      "kind": "text",
      "x": 40,
      "y": 1968,
      "src": "Esbeltez global: el límite de 8.6.3 es 1,5 veces la transición de Euler."
    },
    {
      "id": "r040",
      "kind": "math",
      "x": 40,
      "y": 2016,
      "src": "esb_d := L_d/r_d ="
    },
    {
      "id": "r041",
      "kind": "math",
      "x": 40,
      "y": 2064,
      "src": "esb_eul := pi*sqrt(E/F_y) ="
    },
    {
      "id": "r042",
      "kind": "math",
      "x": 40,
      "y": 2112,
      "src": "esb_max := 1.5*esb_eul ="
    },
    {
      "id": "v_esbd",
      "kind": "math",
      "x": 40,
      "y": 2160,
      "src": "esb_d <= esb_max ="
    },
    {
      "id": "r044",
      "kind": "text",
      "x": 40,
      "y": 2208,
      "src": "Compresión de diseño de la diagonal soldada (NCh427/1 E3, con F_y):"
    },
    {
      "id": "r045",
      "kind": "program",
      "x": 40,
      "y": 2256,
      "src": "F_cr :=\n    F_e := pi^2*E/esb_d^2\n    lim := 4.71*sqrt(E/F_y)\n    if esb_d <= lim\n        return 0.658^(F_y/F_e)*F_y\n    return 0.877*F_e"
    },
    {
      "id": "r046",
      "kind": "math",
      "x": 40,
      "y": 2384,
      "src": "F_cr = kgf/cm^2"
    },
    {
      "id": "r047",
      "kind": "math",
      "x": 40,
      "y": 2432,
      "src": "Rd_d := phi*F_cr*A_d = tonf"
    },
    {
      "id": "r048",
      "kind": "math",
      "x": 40,
      "y": 2480,
      "src": "u_d := P_E/Rd_d ="
    },
    {
      "id": "v_d",
      "kind": "math",
      "x": 40,
      "y": 2528,
      "src": "Rd_d >= P_E ="
    },
    {
      "id": "r050",
      "kind": "text",
      "x": 40,
      "y": 2592,
      "src": "━━ 1b · LA SECCIÓN DE CATÁLOGO QUE NO PASA ([] 200×200×5,0) ━━"
    },
    {
      "id": "r051",
      "kind": "text",
      "x": 40,
      "y": 2640,
      "src": "Cajón conformado en frío, ICHA Tabla 2.1.9 — datos de catálogo, no derivados acá."
    },
    {
      "id": "r052",
      "kind": "math",
      "x": 40,
      "y": 2688,
      "src": "A_x := 38.14 cm^2"
    },
    {
      "id": "r053",
      "kind": "math",
      "x": 40,
      "y": 2736,
      "src": "r_x := 7.91 cm"
    },
    {
      "id": "r054",
      "kind": "math",
      "x": 40,
      "y": 2784,
      "src": "bt_x := 35.0"
    },
    {
      "id": "v_btx",
      "kind": "math",
      "x": 40,
      "y": 2832,
      "src": "bt_x <= lam_md ="
    },
    {
      "id": "r056",
      "kind": "math",
      "x": 40,
      "y": 2880,
      "src": "u_btx := bt_x/lam_md ="
    },
    {
      "id": "r057",
      "kind": "text",
      "x": 40,
      "y": 2928,
      "src": "La esbeltez global sí holga; es el pandeo local el que la deja fuera."
    },
    {
      "id": "r058",
      "kind": "math",
      "x": 40,
      "y": 2976,
      "src": "esb_x := L_d/r_x ="
    },
    {
      "id": "v_esbx",
      "kind": "math",
      "x": 40,
      "y": 3024,
      "src": "esb_x <= esb_max ="
    },
    {
      "id": "r060",
      "kind": "program",
      "x": 40,
      "y": 3072,
      "src": "F_crx :=\n    F_ex := pi^2*E/esb_x^2\n    lim := 4.71*sqrt(E/F_y)\n    if esb_x <= lim\n        return 0.658^(F_y/F_ex)*F_y\n    return 0.877*F_ex"
    },
    {
      "id": "r061",
      "kind": "math",
      "x": 40,
      "y": 3200,
      "src": "Rd_x := phi*F_crx*A_x = tonf"
    },
    {
      "id": "r062",
      "kind": "math",
      "x": 40,
      "y": 3248,
      "src": "u_x := P_E/Rd_x ="
    },
    {
      "id": "r063",
      "kind": "text",
      "x": 40,
      "y": 3296,
      "src": "La exención de 8.6.3: acogerse a ella obliga a diseñar con el sismo amplificado por 0,7R_1."
    },
    {
      "id": "r064",
      "kind": "math",
      "x": 40,
      "y": 3344,
      "src": "amp := 0.7*R_1 ="
    },
    {
      "id": "r065",
      "kind": "math",
      "x": 40,
      "y": 3392,
      "src": "Pu_x := amp*P_E = tonf"
    },
    {
      "id": "v_exen",
      "kind": "math",
      "x": 40,
      "y": 3440,
      "src": "Rd_x >= Pu_x ="
    },
    {
      "id": "r067",
      "kind": "math",
      "x": 40,
      "y": 3488,
      "src": "u_exen := Pu_x/Rd_x ="
    },
    {
      "id": "r068",
      "kind": "text",
      "x": 40,
      "y": 3536,
      "src": "Las dos puertas cerradas: ni cumple lam_md ni aguanta el sismo amplificado. Hay que soldar."
    },
    {
      "id": "r069",
      "kind": "text",
      "x": 40,
      "y": 3600,
      "src": "━━ 2 · LAS CAPACIDADES ESPERADAS (8.3.1) ━━"
    },
    {
      "id": "r070",
      "kind": "text",
      "x": 40,
      "y": 3648,
      "src": "No son resistencias de diseño: son la carga que el elemento traspasa al plastificar."
    },
    {
      "id": "r071",
      "kind": "math",
      "x": 40,
      "y": 3696,
      "src": "T_ye := F_ye*A_d = tonf"
    },
    {
      "id": "r072",
      "kind": "text",
      "x": 40,
      "y": 3744,
      "src": "F_cre es la curva de columna evaluada con F_ye en lugar de F_y:"
    },
    {
      "id": "r073",
      "kind": "math",
      "x": 40,
      "y": 3792,
      "src": "F_e := pi^2*E/esb_d^2 = kgf/cm^2"
    },
    {
      "id": "r074",
      "kind": "program",
      "x": 40,
      "y": 3840,
      "src": "F_cre :=\n    lim := 4.71*sqrt(E/F_ye)\n    if esb_d <= lim\n        return 0.658^(F_ye/F_e)*F_ye\n    return 0.877*F_e"
    },
    {
      "id": "r075",
      "kind": "math",
      "x": 40,
      "y": 3952,
      "src": "F_cre = kgf/cm^2"
    },
    {
      "id": "r076",
      "kind": "math",
      "x": 40,
      "y": 4000,
      "src": "P_ne := 1.14*F_cre*A_d = tonf"
    },
    {
      "id": "r077",
      "kind": "math",
      "x": 40,
      "y": 4048,
      "src": "P_res := 0.3*P_ne = tonf"
    },
    {
      "id": "r078",
      "kind": "text",
      "x": 40,
      "y": 4112,
      "src": "━━ 3 · EL DESEQUILIBRIO QUE EL ANÁLISIS NO VE (8.6.6) ━━"
    },
    {
      "id": "r079",
      "kind": "text",
      "x": 40,
      "y": 4160,
      "src": "Positivo hacia abajo: la traccionada tira el nudo hacia su base, la pandeada lo empuja."
    },
    {
      "id": "r080",
      "kind": "math",
      "x": 40,
      "y": 4208,
      "src": "V_cru := sin(alf)*(T_ye - P_res) = tonf"
    },
    {
      "id": "r081",
      "kind": "math",
      "x": 40,
      "y": 4256,
      "src": "N_cru := cos(alf)*(T_ye + P_res) = tonf"
    },
    {
      "id": "r082",
      "kind": "text",
      "x": 40,
      "y": 4304,
      "src": "La viga, sin apoyo central, simplemente apoyada entre columnas:"
    },
    {
      "id": "r083",
      "kind": "math",
      "x": 40,
      "y": 4352,
      "src": "M_gra := w*L^2/8 = tonf*m"
    },
    {
      "id": "r084",
      "kind": "math",
      "x": 40,
      "y": 4400,
      "src": "M_cru := M_gra + V_cru*L/4 = tonf*m"
    },
    {
      "id": "r085",
      "kind": "text",
      "x": 40,
      "y": 4448,
      "src": "Lo que entregaba el análisis elástico es el momento negativo sobre el apoyo central"
    },
    {
      "id": "r086",
      "kind": "text",
      "x": 40,
      "y": 4496,
      "src": "de una viga continua de dos tramos: w·L²/32. Otra sección y otro signo, pero es el pico"
    },
    {
      "id": "r087",
      "kind": "text",
      "x": 40,
      "y": 4544,
      "src": "de |M| de ese estado, que es lo que dimensiona."
    },
    {
      "id": "r088",
      "kind": "math",
      "x": 40,
      "y": 4592,
      "src": "M_ela := w*L^2/32 = tonf*m"
    },
    {
      "id": "r089",
      "kind": "math",
      "x": 40,
      "y": 4640,
      "src": "raz_cru := M_cru/M_ela ="
    },
    {
      "id": "r090",
      "kind": "text",
      "x": 40,
      "y": 4688,
      "src": "Con ese momento cualquier perfil sirve — el módulo plástico que pide es ridículo:"
    },
    {
      "id": "r091",
      "kind": "math",
      "x": 40,
      "y": 4736,
      "src": "Z_req := M_ela/(phi*F_y) = cm^3"
    },
    {
      "id": "r092",
      "kind": "text",
      "x": 40,
      "y": 4800,
      "src": "━━ 4 · LOS DOS TECHOS DE 8.6.6 ━━"
    },
    {
      "id": "r093",
      "kind": "text",
      "x": 40,
      "y": 4848,
      "src": "Techo 1, sobre la fuerza: la tracción no necesita ser mayor que la de 4.5 amplificada."
    },
    {
      "id": "r094",
      "kind": "text",
      "x": 40,
      "y": 4896,
      "src": "Ojo: aplica solo a la tracción. La residual de la comprimida no tiene tope."
    },
    {
      "id": "r095",
      "kind": "math",
      "x": 40,
      "y": 4944,
      "src": "T_cap := amp*P_E = tonf"
    },
    {
      "id": "r096",
      "kind": "math",
      "x": 40,
      "y": 4992,
      "src": "T_dis := min(T_ye, T_cap) = tonf"
    },
    {
      "id": "r097",
      "kind": "math",
      "x": 40,
      "y": 5040,
      "src": "V_dis := sin(alf)*(T_dis - P_res) = tonf"
    },
    {
      "id": "r098",
      "kind": "math",
      "x": 40,
      "y": 5088,
      "src": "N_dis := cos(alf)*(T_dis + P_res) = tonf"
    },
    {
      "id": "r099",
      "kind": "math",
      "x": 40,
      "y": 5136,
      "src": "M_dis := M_gra + V_dis*L/4 = tonf*m"
    },
    {
      "id": "r100",
      "kind": "math",
      "x": 40,
      "y": 5184,
      "src": "raz_dis := M_dis/M_ela ="
    },
    {
      "id": "r101",
      "kind": "math",
      "x": 40,
      "y": 5232,
      "src": "baja := 1 - M_dis/M_cru ="
    },
    {
      "id": "r102",
      "kind": "text",
      "x": 40,
      "y": 5280,
      "src": "Techo 2, sobre el elemento: la máxima carga que el sistema le puede transferir (C8.3.4)."
    },
    {
      "id": "r103",
      "kind": "text",
      "x": 40,
      "y": 5328,
      "src": "Exige métodos no lineales, así que acá no se cuantifica; suele ser el que gobierna."
    },
    {
      "id": "r104",
      "kind": "text",
      "x": 40,
      "y": 5392,
      "src": "━━ 5 · LA VIGA H 600×300×138,5 (ICHA Tabla 2.1.1) ━━"
    },
    {
      "id": "r105",
      "kind": "text",
      "x": 40,
      "y": 5440,
      "src": "Perfil soldado: las propiedades salen de las planchas, igual que la diagonal."
    },
    {
      "id": "r106",
      "kind": "math",
      "x": 40,
      "y": 5488,
      "src": "d_v := 60 cm"
    },
    {
      "id": "r107",
      "kind": "math",
      "x": 40,
      "y": 5536,
      "src": "bf := 30 cm"
    },
    {
      "id": "r108",
      "kind": "math",
      "x": 40,
      "y": 5584,
      "src": "tf := 2.2 cm"
    },
    {
      "id": "r109",
      "kind": "math",
      "x": 40,
      "y": 5632,
      "src": "tw := 0.8 cm"
    },
    {
      "id": "r110",
      "kind": "math",
      "x": 40,
      "y": 5680,
      "src": "h_v := d_v - 2*tf = cm"
    },
    {
      "id": "r111",
      "kind": "math",
      "x": 40,
      "y": 5728,
      "src": "A_v := 2*bf*tf + h_v*tw = cm^2"
    },
    {
      "id": "r112",
      "kind": "math",
      "x": 40,
      "y": 5776,
      "src": "Ix := (bf*d_v^3 - (bf - tw)*h_v^3)/12 = cm^4"
    },
    {
      "id": "r113",
      "kind": "math",
      "x": 40,
      "y": 5824,
      "src": "Sx := 2*Ix/d_v = cm^3"
    },
    {
      "id": "r114",
      "kind": "math",
      "x": 40,
      "y": 5872,
      "src": "Zx := bf*tf*(d_v - tf) + tw*h_v^2/4 = cm^3"
    },
    {
      "id": "r115",
      "kind": "math",
      "x": 40,
      "y": 5920,
      "src": "Iy := (2*tf*bf^3 + h_v*tw^3)/12 = cm^4"
    },
    {
      "id": "r116",
      "kind": "math",
      "x": 40,
      "y": 5968,
      "src": "ry := sqrt(Iy/A_v) = cm"
    },
    {
      "id": "r117",
      "kind": "math",
      "x": 40,
      "y": 6016,
      "src": "htw := h_v/tw ="
    },
    {
      "id": "r118",
      "kind": "math",
      "x": 40,
      "y": 6064,
      "src": "btf := bf/(2*tf) ="
    },
    {
      "id": "r119",
      "kind": "text",
      "x": 40,
      "y": 6112,
      "src": "Compresión: el arriostramiento de la plataforma cada 2,0 m fija la longitud de pandeo."
    },
    {
      "id": "r120",
      "kind": "math",
      "x": 40,
      "y": 6160,
      "src": "esb_v := L_b/ry ="
    },
    {
      "id": "r121",
      "kind": "program",
      "x": 40,
      "y": 6208,
      "src": "F_crv :=\n    F_ev := pi^2*E/esb_v^2\n    lim := 4.71*sqrt(E/F_y)\n    if esb_v <= lim\n        return 0.658^(F_y/F_ev)*F_y\n    return 0.877*F_ev"
    },
    {
      "id": "r122",
      "kind": "math",
      "x": 40,
      "y": 6336,
      "src": "Rd_pv := phi*F_crv*A_v = tonf"
    },
    {
      "id": "r123",
      "kind": "text",
      "x": 40,
      "y": 6384,
      "src": "Compacidad del alma bajo el axial (NCh427/1 Tabla B4.1b, caso 15):"
    },
    {
      "id": "r124",
      "kind": "math",
      "x": 40,
      "y": 6432,
      "src": "P_yv := F_y*A_v = tonf"
    },
    {
      "id": "r125",
      "kind": "math",
      "x": 40,
      "y": 6480,
      "src": "C_a := N_dis/(phi*P_yv) ="
    },
    {
      "id": "v_ca",
      "kind": "math",
      "x": 40,
      "y": 6528,
      "src": "C_a > 0.125 ="
    },
    {
      "id": "r127",
      "kind": "math",
      "x": 40,
      "y": 6576,
      "src": "lam_pw := 1.12*sqrt(E/F_y)*(2.33 - C_a) ="
    },
    {
      "id": "r128",
      "kind": "math",
      "x": 40,
      "y": 6624,
      "src": "lam_pwf := 3.76*sqrt(E/F_y) ="
    },
    {
      "id": "r129",
      "kind": "math",
      "x": 40,
      "y": 6672,
      "src": "lam_rw := 5.70*sqrt(E/F_y) ="
    },
    {
      "id": "v_alma",
      "kind": "math",
      "x": 40,
      "y": 6720,
      "src": "htw <= lam_pw ="
    },
    {
      "id": "r131",
      "kind": "text",
      "x": 40,
      "y": 6768,
      "src": "Alma no compacta → Sec. F4 con el factor de plastificación R_pc, no M_p directo."
    },
    {
      "id": "r132",
      "kind": "math",
      "x": 40,
      "y": 6816,
      "src": "M_p := F_y*Zx = tonf*m"
    },
    {
      "id": "r133",
      "kind": "math",
      "x": 40,
      "y": 6864,
      "src": "M_yc := F_y*Sx = tonf*m"
    },
    {
      "id": "r134",
      "kind": "program",
      "x": 40,
      "y": 6912,
      "src": "R_pc :=\n    rel := M_p/M_yc\n    if htw <= lam_pw\n        return rel\n    return min(rel - (rel - 1)*(htw - lam_pw)/(lam_rw - lam_pw), rel)"
    },
    {
      "id": "r135",
      "kind": "math",
      "x": 40,
      "y": 7024,
      "src": "R_pc ="
    },
    {
      "id": "r136",
      "kind": "math",
      "x": 40,
      "y": 7072,
      "src": "M_nv := min(R_pc*M_yc, M_p) = tonf*m"
    },
    {
      "id": "r137",
      "kind": "math",
      "x": 40,
      "y": 7120,
      "src": "Rd_mv := phi*M_nv = tonf*m"
    },
    {
      "id": "r138",
      "kind": "math",
      "x": 40,
      "y": 7168,
      "src": "cast := 1 - M_nv/M_p ="
    },
    {
      "id": "r139",
      "kind": "text",
      "x": 40,
      "y": 7216,
      "src": "El ala, por la fila de elementos NO atiesados de la Tabla 9 (alas de perfiles I, H):"
    },
    {
      "id": "r140",
      "kind": "math",
      "x": 40,
      "y": 7264,
      "src": "lam_af := 0.40*sqrt(E/F_ye) ="
    },
    {
      "id": "v_ala",
      "kind": "math",
      "x": 40,
      "y": 7312,
      "src": "btf <= lam_af ="
    },
    {
      "id": "r142",
      "kind": "text",
      "x": 40,
      "y": 7360,
      "src": "Interacción flexo-compresión (NCh427/1 H1-1a), con M y N simultáneos:"
    },
    {
      "id": "r143",
      "kind": "math",
      "x": 40,
      "y": 7408,
      "src": "rel_p := N_dis/Rd_pv ="
    },
    {
      "id": "v_h1a",
      "kind": "math",
      "x": 40,
      "y": 7456,
      "src": "rel_p >= 0.2 ="
    },
    {
      "id": "r145",
      "kind": "math",
      "x": 40,
      "y": 7504,
      "src": "u_v := rel_p + (8/9)*(M_dis/Rd_mv) ="
    },
    {
      "id": "v_viga",
      "kind": "math",
      "x": 40,
      "y": 7552,
      "src": "u_v <= 1 ="
    },
    {
      "id": "r147",
      "kind": "text",
      "x": 40,
      "y": 7616,
      "src": "━━ 5b · LA QUE UNO ELEGIRÍA MIRANDO EL MODELO: H 400×200×109,5 ━━"
    },
    {
      "id": "r148",
      "kind": "math",
      "x": 40,
      "y": 7664,
      "src": "d_w := 40 cm"
    },
    {
      "id": "r149",
      "kind": "math",
      "x": 40,
      "y": 7712,
      "src": "bf_w := 20 cm"
    },
    {
      "id": "r150",
      "kind": "math",
      "x": 40,
      "y": 7760,
      "src": "tf_w := 2.8 cm"
    },
    {
      "id": "r151",
      "kind": "math",
      "x": 40,
      "y": 7808,
      "src": "tw_w := 0.8 cm"
    },
    {
      "id": "r152",
      "kind": "math",
      "x": 40,
      "y": 7856,
      "src": "h_w := d_w - 2*tf_w = cm"
    },
    {
      "id": "r153",
      "kind": "math",
      "x": 40,
      "y": 7904,
      "src": "A_w := 2*bf_w*tf_w + h_w*tw_w = cm^2"
    },
    {
      "id": "r154",
      "kind": "math",
      "x": 40,
      "y": 7952,
      "src": "Ix_w := (bf_w*d_w^3 - (bf_w - tw_w)*h_w^3)/12 = cm^4"
    },
    {
      "id": "r155",
      "kind": "math",
      "x": 40,
      "y": 8000,
      "src": "Zx_w := bf_w*tf_w*(d_w - tf_w) + tw_w*h_w^2/4 = cm^3"
    },
    {
      "id": "r156",
      "kind": "math",
      "x": 40,
      "y": 8048,
      "src": "Iy_w := (2*tf_w*bf_w^3 + h_w*tw_w^3)/12 = cm^4"
    },
    {
      "id": "r157",
      "kind": "math",
      "x": 40,
      "y": 8096,
      "src": "ry_w := sqrt(Iy_w/A_w) = cm"
    },
    {
      "id": "r158",
      "kind": "math",
      "x": 40,
      "y": 8144,
      "src": "htw_w := h_w/tw_w ="
    },
    {
      "id": "r159",
      "kind": "math",
      "x": 40,
      "y": 8192,
      "src": "esb_w := L_b/ry_w ="
    },
    {
      "id": "r160",
      "kind": "program",
      "x": 40,
      "y": 8240,
      "src": "F_crw :=\n    F_ew := pi^2*E/esb_w^2\n    lim := 4.71*sqrt(E/F_y)\n    if esb_w <= lim\n        return 0.658^(F_y/F_ew)*F_y\n    return 0.877*F_ew"
    },
    {
      "id": "r161",
      "kind": "math",
      "x": 40,
      "y": 8368,
      "src": "Rd_pw := phi*F_crw*A_w = tonf"
    },
    {
      "id": "r162",
      "kind": "text",
      "x": 40,
      "y": 8416,
      "src": "Su alma sí es compacta bajo este axial, así que M_n = M_p sin castigo:"
    },
    {
      "id": "r163",
      "kind": "math",
      "x": 40,
      "y": 8464,
      "src": "C_aw := N_dis/(phi*F_y*A_w) ="
    },
    {
      "id": "r164",
      "kind": "math",
      "x": 40,
      "y": 8512,
      "src": "lam_pww := 1.12*sqrt(E/F_y)*(2.33 - C_aw) ="
    },
    {
      "id": "v_almaw",
      "kind": "math",
      "x": 40,
      "y": 8560,
      "src": "htw_w <= lam_pww ="
    },
    {
      "id": "r166",
      "kind": "math",
      "x": 40,
      "y": 8608,
      "src": "L_p := 1.76*ry_w*sqrt(E/F_y) = cm"
    },
    {
      "id": "v_lp",
      "kind": "math",
      "x": 40,
      "y": 8656,
      "src": "L_p >= L_b ="
    },
    {
      "id": "r168",
      "kind": "math",
      "x": 40,
      "y": 8704,
      "src": "Rd_mw := phi*F_y*Zx_w = tonf*m"
    },
    {
      "id": "r169",
      "kind": "math",
      "x": 40,
      "y": 8752,
      "src": "u_w := N_dis/Rd_pw + (8/9)*(M_dis/Rd_mw) ="
    },
    {
      "id": "v_vigaw",
      "kind": "math",
      "x": 40,
      "y": 8800,
      "src": "u_w <= 1 ="
    },
    {
      "id": "r171",
      "kind": "text",
      "x": 40,
      "y": 8848,
      "src": "1,57: la familia que sugiere el modelo elástico no da. Hay que subir de familia, no soldar"
    },
    {
      "id": "r172",
      "kind": "text",
      "x": 40,
      "y": 8896,
      "src": "a medida: la H 600×300×138,5 está en la misma Tabla 2.1.1 del ICHA."
    },
    {
      "id": "r173",
      "kind": "math",
      "x": 40,
      "y": 8944,
      "src": "sube := A_v/A_w - 1 ="
    },
    {
      "id": "r174",
      "kind": "text",
      "x": 40,
      "y": 9008,
      "src": "━━ 6 · LO QUE 8.6.6 AGREGA Y CASI NADIE PONE ━━",
      "pageBreak": true
    },
    {
      "id": "r175",
      "kind": "text",
      "x": 40,
      "y": 9056,
      "src": "Carga transversal fuera del plano en el punto de unión con la diagonal comprimida,"
    },
    {
      "id": "r176",
      "kind": "text",
      "x": 40,
      "y": 9104,
      "src": "igual al 2 % de su capacidad esperada en compresión:"
    },
    {
      "id": "r177",
      "kind": "math",
      "x": 40,
      "y": 9152,
      "src": "F_tra := 0.02*P_ne = tonf"
    },
    {
      "id": "r178",
      "kind": "text",
      "x": 40,
      "y": 9200,
      "src": "Separación entre puntos de trabajo de las diagonales, medida en el eje de la viga:"
    },
    {
      "id": "r179",
      "kind": "math",
      "x": 40,
      "y": 9248,
      "src": "e_max := 2*d_v = m"
    },
    {
      "id": "r180",
      "kind": "text",
      "x": 40,
      "y": 9296,
      "src": "Y la conexión viga-columna se diseña para M_dis y N_dis SIMULTÁNEOS, no cada uno aparte."
    },
    {
      "id": "r181",
      "kind": "text",
      "x": 40,
      "y": 9360,
      "src": "━━ 7 · EL APORTE EN TRACCIÓN DE LA LÍNEA (8.6.2) ━━"
    },
    {
      "id": "r182",
      "kind": "text",
      "x": 40,
      "y": 9408,
      "src": "Las traccionadas deben dar al menos el 30 % del corte de la línea, en cada sentido."
    },
    {
      "id": "r183",
      "kind": "math",
      "x": 40,
      "y": 9456,
      "src": "Rd_t := phi*F_y*A_d = tonf"
    },
    {
      "id": "r184",
      "kind": "math",
      "x": 40,
      "y": 9504,
      "src": "ap_t := Rd_t*cos(alf) = tonf"
    },
    {
      "id": "r185",
      "kind": "math",
      "x": 40,
      "y": 9552,
      "src": "Q_min := 0.30*Q = tonf"
    },
    {
      "id": "v_862",
      "kind": "math",
      "x": 40,
      "y": 9600,
      "src": "ap_t >= Q_min ="
    },
    {
      "id": "r187",
      "kind": "math",
      "x": 40,
      "y": 9648,
      "src": "u_862 := Q_min/ap_t ="
    },
    {
      "id": "r188",
      "kind": "text",
      "x": 40,
      "y": 9712,
      "src": "━━ 8 · LA DIAGONAL ROBUSTA ADEMÁS ALIVIANA LA VIGA ━━"
    },
    {
      "id": "r189",
      "kind": "text",
      "x": 40,
      "y": 9760,
      "src": "Si el [] 200×200×5,0 hubiera sido admisible — no lo es — su desequilibrio sería mayor,"
    },
    {
      "id": "r190",
      "kind": "text",
      "x": 40,
      "y": 9808,
      "src": "porque la tracción ya está topada y no crece, pero la residual sí crece con la sección."
    },
    {
      "id": "r191",
      "kind": "math",
      "x": 40,
      "y": 9856,
      "src": "T_yex := F_ye*A_x = tonf"
    },
    {
      "id": "r192",
      "kind": "program",
      "x": 40,
      "y": 9904,
      "src": "F_crex :=\n    lim := 4.71*sqrt(E/F_ye)\n    F_ex2 := pi^2*E/esb_x^2\n    if esb_x <= lim\n        return 0.658^(F_ye/F_ex2)*F_ye\n    return 0.877*F_ex2"
    },
    {
      "id": "r193",
      "kind": "math",
      "x": 40,
      "y": 10032,
      "src": "P_nex := 1.14*F_crex*A_x = tonf"
    },
    {
      "id": "r194",
      "kind": "math",
      "x": 40,
      "y": 10080,
      "src": "P_resx := 0.3*P_nex = tonf"
    },
    {
      "id": "r195",
      "kind": "math",
      "x": 40,
      "y": 10128,
      "src": "T_disx := min(T_yex, T_cap) = tonf"
    },
    {
      "id": "r196",
      "kind": "math",
      "x": 40,
      "y": 10176,
      "src": "M_disx := M_gra + sin(alf)*(T_disx - P_resx)*L/4 = tonf*m"
    },
    {
      "id": "r197",
      "kind": "math",
      "x": 40,
      "y": 10224,
      "src": "ahorro := 1 - M_dis/M_disx ="
    },
    {
      "id": "r198",
      "kind": "text",
      "x": 40,
      "y": 10272,
      "src": "Un 37 % menos de momento con la diagonal más robusta: el desequilibrio es una resta."
    },
    {
      "id": "r199",
      "kind": "math",
      "x": 40,
      "y": 10320,
      "src": "peso := 2*L_d*60 kgf/m + L*138.5 kgf/m = kgf"
    },
    {
      "id": "r200",
      "kind": "text",
      "x": 40,
      "y": 10384,
      "src": "━━ 9 · SENSIBILIDAD — R_1 ES EL PARÁMETRO DOMINANTE ━━",
      "pageBreak": true
    },
    {
      "id": "r201",
      "kind": "text",
      "x": 40,
      "y": 10432,
      "src": "El techo de 0,7R_1 decide cuánto muerde. Y solo deja de morder cuando supera T_ye:"
    },
    {
      "id": "r202",
      "kind": "math",
      "x": 40,
      "y": 10480,
      "src": "R1_lib := T_ye/(0.7*P_E) ="
    },
    {
      "id": "r203",
      "kind": "text",
      "x": 40,
      "y": 10528,
      "src": "Y hay un segundo umbral, por abajo: si el techo deja la tracción por DEBAJO de la"
    },
    {
      "id": "r204",
      "kind": "text",
      "x": 40,
      "y": 10576,
      "src": "residual, el desequilibrio se invierte —apunta hacia arriba— y descarga la viga."
    },
    {
      "id": "r205",
      "kind": "math",
      "x": 40,
      "y": 10624,
      "src": "R1_cru := P_res/(0.7*P_E) ="
    },
    {
      "id": "r206",
      "kind": "text",
      "x": 40,
      "y": 10672,
      "src": "Por eso el momento de diseño es la envolvente de dos combinaciones: la sísmica de 8.6.6"
    },
    {
      "id": "r207",
      "kind": "text",
      "x": 40,
      "y": 10720,
      "src": "y la gravedad sola, que en esta cláusula actúa sobre los 8 m SIN apoyo central. Con el"
    },
    {
      "id": "r208",
      "kind": "text",
      "x": 40,
      "y": 10768,
      "src": "desequilibrio invertido la sísmica cae por debajo y manda la gravedad."
    },
    {
      "id": "r209",
      "kind": "program",
      "x": 40,
      "y": 10816,
      "src": "M_R1 :=\n    out := []\n    for k in [2, 3, 4, 5, 6]\n        Tk := min(T_ye, 0.7*k*P_E)\n        Vk := sin(alf)*(Tk - P_res)\n        out := concat(out, [max(M_gra, M_gra + Vk*L/4) to tonf*m])\n    return out"
    },
    {
      "id": "r210",
      "kind": "math",
      "x": 40,
      "y": 10976,
      "src": "M_R1 ="
    },
    {
      "id": "r211",
      "kind": "text",
      "x": 40,
      "y": 11024,
      "src": "El R_y funciona al revés: subirlo BAJA el momento, porque la tracción ya está topada"
    },
    {
      "id": "r212",
      "kind": "text",
      "x": 40,
      "y": 11072,
      "src": "y la residual crece. En lam_md (§1) el mismo factor tira para el otro lado."
    },
    {
      "id": "r213",
      "kind": "program",
      "x": 40,
      "y": 11120,
      "src": "M_Ry :=\n    out := []\n    for k in [1.1, 1.3, 1.5]\n        Fk := k*F_y\n        lim := 4.71*sqrt(E/Fk)\n        Fck := 0.658^(Fk/F_e)*Fk\n        if esb_d > lim\n            Fck := 0.877*F_e\n        Pk := 0.3*1.14*Fck*A_d\n        Tk := min(Fk*A_d, T_cap)\n        out := concat(out, [(M_gra + sin(alf)*(Tk - Pk)*L/4) to tonf*m])\n    return out"
    },
    {
      "id": "r214",
      "kind": "math",
      "x": 40,
      "y": 11376,
      "src": "M_Ry ="
    },
    {
      "id": "r215",
      "kind": "text",
      "x": 40,
      "y": 11424,
      "src": "El ángulo, a luz fija: cambiarlo cambia la altura, el largo de la diagonal y con él P_ne."
    },
    {
      "id": "r216",
      "kind": "program",
      "x": 40,
      "y": 11472,
      "src": "M_alf :=\n    out := []\n    for g in [30, 40, 45, 50, 60]\n        a := g*pi/180\n        Lk := (L/2)/cos(a)\n        ek := Lk/r_d\n        Fek := pi^2*E/ek^2\n        Fck := 0.658^(F_ye/Fek)*F_ye\n        if ek > 4.71*sqrt(E/F_ye)\n            Fck := 0.877*Fek\n        Pk := 0.3*1.14*Fck*A_d\n        out := concat(out, [(M_gra + sin(a)*(T_cap - Pk)*L/4) to tonf*m])\n    return out"
    },
    {
      "id": "r217",
      "kind": "math",
      "x": 40,
      "y": 11744,
      "src": "M_alf ="
    },
