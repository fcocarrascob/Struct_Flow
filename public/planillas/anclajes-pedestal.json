   "x": 40,
   "y": 7072
  },
  {
   "id": "r142",
   "kind": "math",
   "src": "V_bB := coef_B * lam * rfc * (c_a1B/mm)^1.5 * N = kgf",
   "x": 40,
   "y": 7136
  },
  {
