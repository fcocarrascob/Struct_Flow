   "y": 8640
  },
  {
   "id": "r172",
   "kind": "math",
   "src": "f_ya := 55 * 6.894757 * MPa = kgf/cm^2",
   "x": 40,
   "y": 8688
  },
  {
   "id": "v008",
   "kind": "math",
   "src": "(f_uta <= 1.9*f_ya) and (f_uta <= 860 MPa) =",
   "x": 40,
   "y": 8736
  },
