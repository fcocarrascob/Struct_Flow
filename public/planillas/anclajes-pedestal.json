   "src": "Rd_Vcg := min(Rd_vb, Rd_pry) = tonf",
   "x": 40,
   "y": 9360
  },
  {
   "id": "r186",
   "kind": "math",
   "src": "i_N := (T_g/Rd_Ncg)^(5/3) =",
