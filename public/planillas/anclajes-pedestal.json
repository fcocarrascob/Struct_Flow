   "y": 8784
  },
  {
   "id": "r174",
   "kind": "math",
   "src": "N_sa := A_se * f_uta = tonf",
   "x": 40,
   "y": 8832
  },
  {
   "id": "r175",
   "kind": "math",
   "src": "Rd_Nsa := phi_sN * N_sa = tonf",
   "x": 40,
   "y": 8880
  },
  {
   "id": "r176",
   "kind": "math",
   "src": "V_sa := 0.6 * A_se * f_uta = tonf",
