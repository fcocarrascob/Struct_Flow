  },
  {
   "id": "r191",
   "kind": "text",
   "src": "17.8.4 (acero, ζ = 2 — R17.8.1 usa 5/3 para hormigón y 2 para acero):",
   "x": 40,
   "y": 9696
  },
  {
   "id": "r192",
