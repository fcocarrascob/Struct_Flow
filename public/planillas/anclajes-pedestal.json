   "y": 5952
  },
  {
   "id": "r120",
   "kind": "math",
   "src": "l_e := min(h_ef, 8*d_a) = cm",
   "x": 40,
   "y": 6000
  },
  {
   "id": "r121",
   "kind": "math",
   "src": "V_b1 := 0.6 * (l_e/d_a)^0.2 * sqrt(d_a/mm) * lam * rfc * (c_a1/mm)^1.5 * N = kgf",
   "x": 40,
   "y": 6048
  },
  {
   "id": "r122",
   "kind": "math",
   "src": "V_b2 := 3.7 * lam * rfc * (c_a1/mm)^1.5 * N = kgf",
   "x": 40,
   "y": 6096
  },
  {
   "id": "r123",
   "kind": "math",
   "src": "V_b := min(V_b1, V_b2) = kgf",
   "x": 40,
   "y": 6144
  },
  {
   "id": "v005",
   "kind": "math",
   "src": "abs(V_b - V_b2) < 0.5 kgf =",
   "x": 40,
   "y": 6192
  },
  {
   "id": "r124",
   "kind": "text",
   "src": "17.7.2.1.3:  A_Vco = 4,5·c_a1²  ·  A_Vc: ancho recortado por los laterales × 1,5·c_a1",
   "x": 40,
   "y": 6240
  },
  {
   "id": "r125",
   "kind": "math",
   "src": "A_Vco := 4.5 * c_a1^2 = cm^2",
   "x": 40,
   "y": 6288
  },
  {
   "id": "r126",
   "kind": "math",
   "src": "AVc_ancho := min(c_a, proy_V) + s_g + min(c_a, proy_V) =",
