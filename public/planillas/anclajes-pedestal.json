   "id": "r177",
   "kind": "math",
   "src": "Rd_Vsa := phi_sV * V_sa = tonf",
   "x": 40,
   "y": 8976
  },
  {
   "id": "r178",
   "kind": "math",
   "src": "u_Nsa := T_i / Rd_Nsa =",
