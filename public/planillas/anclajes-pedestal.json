   "y": 7376
  },
  {
   "id": "r148",
   "kind": "math",
   "src": "psi_edVB := min(1, 0.7 + 0.3*c_a/(1.5*c_a1B)) =",
   "x": 40,
   "y": 7424
  },
  {
   "id": "r149",
   "kind": "math",
   "src": "psi_hVB := max(1, sqrt(proy_VB/h_a)) =",
   "x": 40,
   "y": 7472
  },
  {
   "id": "r150",
   "kind": "math",
   "src": "Rd_vbB := phiPsi * A_VcB/A_VcoB * psi_edVB * psi_hVB * V_bB = tonf",
   "x": 40,
   "y": 7520
  },
  {
   "id": "v006",
   "kind": "math",
   "src": "Rd_vb < Rd_vbB =",
   "x": 40,
   "y": 7568
  },
  {
