   "y": 10320
  },
  {
   "id": "gob",
   "kind": "program",
   "src": "gobierna :=\nif u_max == I_c\n  return \"interacción N–V del hormigón (17.8.3)\"\nelse if u_max == u_bt\n  return \"breakout en tracción (17.6.2)\"\nelse if u_max == u_vb\n  return \"breakout de corte (17.7.2)\"\nelse if u_max == u_po\n  return \"pullout (17.6.3)\"\nelse if u_max == u_pry\n  return \"pryout (17.7.3)\"\nelse\n  return \"acero del perno (17.8.4)\"",
   "x": 40,
   "y": 10368
  },
  {
   "id": "v_global",
   "kind": "math",
   "src": "u_max <= 1 =",
   "x": 40,
