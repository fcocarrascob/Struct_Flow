   "y": 5712
  },
  {
   "id": "r116",
   "kind": "text",
   "src": "17.7.2.1.2 solo capa c_a1 si los c_a2 Y el espesor h_a quedan bajo 1,5·c_a1",
   "x": 40,
   "y": 5760
  },
  {
   "id": "r117",
   "kind": "math",
   "src": "c_a1 := c_a",
