    },
    {
      "id": "r109",
      "kind": "math",
      "x": 40,
      "y": 5648,
      "src": "R_A := sqrt(H_A^2 + V_A^2) = tonf"
    },
    {
      "id": "r110",
      "kind": "text",
      "x": 40,
      "y": 5696,
      "src": "7a · La pierna la fija la PLANCHA, no la carga (AISC 341-22 F2.6c.4)"
