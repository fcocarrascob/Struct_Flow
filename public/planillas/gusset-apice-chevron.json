      "x": 40,
      "y": 5792,
      "src": "q_cm := 2*0.75*0.6*F_EXX*0.707 = tonf/cm^2"
    },
    {
      "id": "r113",
      "kind": "math",
      "x": 40,
      "y": 5840,
