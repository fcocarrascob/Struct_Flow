      "id": "v_bc2",
      "kind": "math",
      "src": "Rd_bc2 >= T_req =",
      "x": 40,
      "y": 8928
    },
    {
      "id": "r535",
      "kind": "text",
      "src": "La fluencia del área bruta no es un chequeo acá: es el fusible que 8.6.8 supone desarrollado",
