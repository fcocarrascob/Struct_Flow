    {
      "id": "gob",
      "kind": "program",
      "src": "gobierna :=\nif u_max == u_ref\n  return \"rotura del área neta reforzada (8.6.8 + D2-2)\"\nelse if u_max == u_ro\n  return \"rotura por retraso de cortante (D2-2 / Caso 5)\"\nelse if u_max == u_com\n  return \"pandeo por flexión de la diagonal (E3-2)\"\nelse if u_max == u_md\n  return \"pandeo local, lambda_md (Tabla 9)\"\nelse if u_max == u_esb\n  return \"esbeltez global (8.6.3)\"\nelse if u_max == u_sol2\n  return \"cordón de filete bajo capacidad esperada (J2-4)\"\nelse if u_max == u_bc2\n  return \"corte de bloque bajo capacidad esperada (J4-5)\"\nelse if u_max == u_sol\n  return \"cordón de filete (J2-4)\"\nelse if u_max == u_bc\n  return \"corte de bloque (J4-5)\"\nelse\n  return \"fluencia en el área bruta (D2-1)\"",
      "x": 40,
      "y": 9616
    },
    {
