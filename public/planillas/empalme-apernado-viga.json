      "y": 6944,
      "src": "Rd_wfl := 1.00*0.6*F_y*A_gvw = tonf"
    },
    {
      "id": "r092",
      "kind": "math",
      "x": 40,
      "y": 6992,
      "src": "A_nvw := n_wp*t_wp*(d_wp - n_w*d_h) = cm^2"
    },
    {
      "id": "r093",
      "kind": "math",
      "x": 40,
      "y": 7040,
      "src": "Rd_wro := 0.75*0.6*F_u*A_nvw = tonf"
    },
    {
      "id": "r094",
      "kind": "math",
      "x": 40,
      "y": 7088,
      "src": "u_wfl := V_u/Rd_wfl ="
    },
    {
      "id": "r095",
      "kind": "math",
      "x": 40,
      "y": 7136,
      "src": "u_wro := V_u/Rd_wro ="
    },
    {
      "id": "v_wfl",
      "kind": "math",
      "x": 40,
      "y": 7184,
      "src": "Rd_wfl >= V_u ="
    },
    {
      "id": "v_wro",
      "kind": "math",
      "x": 40,
      "y": 7232,
      "src": "Rd_wro >= V_u ="
    },
    {
      "id": "r096",
      "kind": "math",
      "x": 40,
      "y": 7280,
      "src": "Z_wp := n_wp*t_wp*d_wp^2/4 = cm^3"
    },
    {
      "id": "r097",
      "kind": "math",
      "x": 40,
      "y": 7328,
      "src": "Rd_wfx := 0.90*F_y*Z_wp = tonf*m"
