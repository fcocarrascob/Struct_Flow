    {
      "id": "t49",
      "kind": "text",
      "x": 40,
      "y": 9600,
      "src": "J3.4: paso mínimo 2⅔d (3d preferido) y distancia libre entre agujeros ≥ d · J3.5: Tabla J3.4M da 28 mm para d = 22 · J3.6: borde máximo 12t ≤ 150 mm"
    },
    {
      "id": "v_s267",
