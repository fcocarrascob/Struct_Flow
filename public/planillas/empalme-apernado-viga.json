      "y": 5488,
      "src": "Rs_1 = tonf"
    },
    {
      "id": "t31",
      "kind": "text",
      "x": 40,
      "y": 5536,
      "src": "Las tres salidas, cada una recalculada desde los datos (no escalando el número redondeado de la otra)"
    },
    {
      "id": "r074",
      "kind": "math",
      "x": 40,
      "y": 5584,
      "src": "Rd_d6A := 6*1.00*mu_A*D_u*h_f*T_b*1 = tonf"
    },
    {
      "id": "r075",
      "kind": "math",
      "x": 40,
      "y": 5632,
      "src": "Rd_d6B := 6*1.00*mu_B*D_u*h_f*T_b*1 = tonf"
    },
    {
      "id": "r076",
      "kind": "math",
      "x": 40,
      "y": 5680,
      "src": "Rd_d6n2 := 6*1.00*mu_A*D_u*h_f*T_b*2 = tonf"
    },
    {
      "id": "r077",
      "kind": "math",
      "x": 40,
      "y": 5728,
      "src": "u_d6A := F_f/Rd_d6A ="
    },
    {
      "id": "r078",
      "kind": "math",
