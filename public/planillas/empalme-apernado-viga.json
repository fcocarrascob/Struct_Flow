      "id": "r098",
      "kind": "math",
      "x": 40,
      "y": 7424,
      "src": "M_dw := M_alm + M_e = tonf*m"
    },
    {
      "id": "r099",
      "kind": "math",
      "x": 40,
      "y": 7472,
      "src": "u_wfx := M_dw/Rd_wfx ="
    },
