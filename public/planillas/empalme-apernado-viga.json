    {
      "id": "r079",
      "kind": "math",
      "x": 40,
      "y": 5824,
      "src": "u_d6n2 := F_f/Rd_d6n2 ="
    },
    {
      "id": "t32",
      "kind": "text",
      "x": 40,
      "y": 5872,
      "src": "Con 6 pernos Clase A el empalme resiste sin romperse, pero DESLIZA"
    },
    {
      "id": "v_d6A",
      "kind": "math",
      "x": 40,
      "y": 5920,
      "src": "Rd_d6A >= F_f ="
