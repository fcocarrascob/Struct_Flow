      "id": "v_wfx",
      "kind": "math",
      "x": 40,
      "y": 7520,
      "src": "Rd_wfx >= M_dw ="
    },
    {
      "id": "s39",
      "kind": "text",
      "x": 40,
      "y": 7584,
      "src": "━━ 6 · EL ALA PERFORADA DE LA VIGA (F13.1) ━━",
