    },
    {
      "id": "r030",
      "kind": "text",
      "x": 40,
      "y": 1008,
      "src": "21.2.1(d): φ = 0,65 para aplastamiento (lectura conservadora; 21.2.1(g) daría 0,75)."
    },
    {
      "id": "r033",
      "kind": "math",
      "x": 40,
      "y": 1056,
      "src": "phi_ap := 0.65"
    },
    {
      "id": "r034",
      "kind": "text",
      "x": 40,
      "y": 1104,
      "src": "21.2.1(b): φ = 0,75 para cortante (corte por fricción, 22.9)."
    },
    {
