    {
      "id": "gob",
      "kind": "program",
      "src": "gobierna :=\nif u_max == u_T\n  return \"el tirante (23.7.2)\"\nelse if u_max == u_s\n  return \"el puntal (23.4)\"\nelse if u_max == u_B\n  return \"la zona nodal B (23.9)\"\nelse if u_max == u_A\n  return \"la zona nodal A (23.9)\"\nelse if u_max == u_ap\n  return \"el aplastamiento bajo la placa (22.8.3)\"\nelse if u_max == u_Vmax\n  return \"el techo global de corte (16.5.2.4)\"\nelse\n  return \"el corte por fricción de la junta (22.9)\"",
      "x": 40,
      "y": 11840
    },
