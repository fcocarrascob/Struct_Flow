    {
      "id": "r296",
      "kind": "text",
      "x": 40,
      "y": 10816,
      "src": "Tabla 25.4.3.2 de 318-25: λ, ψ_e, ψ_s, ψ_cc y ψ_r (ψ_o y ψ_c eran de 318-19)."
    },
    {
      "id": "r299",
      "kind": "math",
      "x": 40,
      "y": 10864,
      "src": "psi_e := 1.0"
    },
    {
      "id": "r300",
      "kind": "math",
      "x": 40,
      "y": 10912,
      "src": "psi_s := 1.0"
    },
    {
      "id": "r301",
      "kind": "math",
      "x": 40,
      "y": 10960,
      "src": "psi_cc := 1.0"
    },
    {
      "id": "r302",
      "kind": "math",
      "x": 40,
      "y": 11008,
      "src": "psi_r := 1.0"
    },
    {
      "id": "r303",
      "kind": "text",
      "x": 40,
      "y": 11056,
      "src": "25.4.3.1(a) tal como está impresa en esta edición SI: f_y·ψ_e·ψ_s·ψ_cc·ψ_r/(21λ√f'c)·d_b"
    },
    {
      "id": "r304",
      "kind": "math",
      "x": 40,
      "y": 11104,
      "src": "ldh_a := f_yM*psi_e*psi_s*psi_cc*psi_r/(21*lam*rfc*MPa)*d_b = cm"
    },
    {
      "id": "r305",
      "kind": "math",
      "x": 40,
      "y": 11152,
      "src": "ldh_lit := max(ldh_a, 8*d_b, 150 mm) = cm"
    },
    {
      "id": "r306",
      "kind": "text",
      "x": 40,
      "y": 11200,
      "src": "Ese literal daría ℓ_dh ≈ 4·d_b. R25.4.3.1 dice que restituye 318-14, cuya constante SI es 0,24:"
    },
    {
      "id": "r310",
      "kind": "math",
      "x": 40,
      "y": 11248,
      "src": "ldh_318_14 := 0.24*f_yM/(lam*rfc*MPa)*d_b = cm"
    },
    {
      "id": "r311",
      "kind": "math",
      "x": 40,
      "y": 11296,
      "src": "razon := ldh_318_14/ldh_a ="
    },
    {
      "id": "r312",
      "kind": "text",
      "x": 40,
      "y": 11344,
      "src": "El cociente es 5: la constante impresa (21) es cinco veces la de 318-14 (4,17). Se toma la conservadora."
    },
    {
      "id": "r314",
      "kind": "math",
      "x": 40,
      "y": 11392,
      "src": "ldh := ldh_318_14 = cm"
    },
    {
      "id": "r315",
      "kind": "text",
      "x": 40,
      "y": 11440,
      "src": "Largo disponible: ancho de columna menos recubrimiento y estribo de la cara opuesta."
