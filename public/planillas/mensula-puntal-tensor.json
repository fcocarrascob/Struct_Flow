      "id": "r317",
      "kind": "math",
      "x": 40,
      "y": 11488,
      "src": "b_col := 40 cm"
    },
    {
      "id": "r318",
      "kind": "math",
      "x": 40,
      "y": 11536,
      "src": "l_disp := b_col - rec - d_e = cm"
