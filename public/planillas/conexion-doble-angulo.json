    {
      "id": "v_goba",
      "kind": "math",
      "x": 40,
      "y": 7536,
      "src": "u_cada == u_roa ="
    },
    {
      "id": "dif_emp",
      "kind": "math",
      "x": 40,
      "y": 7584,
      "src": "dif_emp := (Rd_alm - Rd_roa)/Rd_roa*100 ="
