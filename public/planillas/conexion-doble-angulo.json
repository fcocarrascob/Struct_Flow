      "id": "v_maxt",
      "kind": "math",
      "x": 40,
      "y": 7776,
      "src": "u_maxt == u_exct ="
    },
    {
      "id": "v_maxa",
      "kind": "math",
      "x": 40,
      "y": 7824,
      "src": "u_maxa == u_exca ="
    },
    {
      "id": "s8",
      "kind": "text",
      "x": 40,
      "y": 7888,
      "src": "━━ 8 · GEOMETRÍA: SEPARACIONES Y DISTANCIAS AL BORDE (J3.4, J3.5, J3.6) ━━"
    },
    {
      "id": "t8",
      "kind": "text",
      "x": 40,
      "y": 7936,
      "src": "J3.4: paso mínimo 2⅔d (3d preferido) y distancia libre entre agujeros ≥ d · J3.5: Tabla J3.4M da 28 mm para d = 22 · J3.6: máximo 12t o 150 mm"
    },
