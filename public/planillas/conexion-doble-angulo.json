    {
      "id": "u_bca",
      "kind": "math",
      "x": 40,
      "y": 5488,
      "src": "u_bca := V_u/Rd_bca ="
    },
    {
      "id": "t5c",
      "kind": "text",
      "x": 40,
      "y": 5536,
      "src": "Decisión declarada: el bloque del ángulo se calcula con L_eh de la plancha (40 mm) y no con el borde libre real del ala de 100 mm. Con 45 mm sería:"
    },
    {
      "id": "A_nt45",
      "kind": "math",
      "x": 40,
      "y": 5584,
      "src": "A_nt45 := (4.5 cm - d_h/2)*t = cm^2"
    },
    {
      "id": "Rd_bc45",
      "kind": "math",
      "x": 40,
      "y": 5632,
      "src": "Rd_bc45 := n_ea*0.75*(min(R_bcr, R_bcy) + U_bs*F_u*A_nt45) = tonf"
    },
    {
      "id": "u_bc45",
      "kind": "math",
      "x": 40,
      "y": 5680,
      "src": "u_bc45 := V_u/Rd_bc45 ="
    },
    {
      "id": "s6",
      "kind": "text",
      "x": 40,
      "y": 5744,
      "src": "━━ 6 · LA EXCENTRICIDAD: LO QUE LA CADENA DE RESISTENCIA ESCONDE ━━"
    },
    {
      "id": "t6a",
      "kind": "text",
      "x": 40,
      "y": 5792,
      "src": "Las verificaciones anteriores suponen la carga aplicada SOBRE la línea de pernos. No lo está: recorre el brazo antes de llegar."
    },
    {
      "id": "M_ut",
      "kind": "math",
      "x": 40,
      "y": 5840,
      "src": "M_ut := V_u*a_t = tonf*m"
    },
    {
      "id": "M_ua",
      "kind": "math",
      "x": 40,
      "y": 5888,
      "src": "M_ua := V_u*a_a = tonf*m"
    },
    {
      "id": "t6b",
      "kind": "text",
      "x": 40,
      "y": 5936,
      "src": "Los elementos lo toman en flexión — J4, con M_p = F_y·Z (fluencia) y F_u·Z_neto (rotura, Manual Parte 9)"
    },
    {
      "id": "Z_1",
      "kind": "math",
      "x": 40,
      "y": 5984,
      "src": "Z_1 := t*d_pl^2/4 = cm^3"
    },
    {
      "id": "dZ",
      "kind": "math",
      "x": 40,
      "y": 6032,
      "src": "dZ := 2*t*d_h*(s/2 + 3*s/2) = cm^3"
    },
    {
      "id": "Zn_1",
      "kind": "math",
      "x": 40,
      "y": 6080,
      "src": "Zn_1 := Z_1 - dZ = cm^3"
    },
    {
      "id": "Z_a",
      "kind": "math",
      "x": 40,
      "y": 6128,
      "src": "Z_a := n_ea*Z_1 = cm^3"
    },
    {
      "id": "Zn_a",
      "kind": "math",
      "x": 40,
      "y": 6176,
      "src": "Zn_a := n_ea*Zn_1 = cm^3"
    },
    {
      "id": "Rd_mflt",
      "kind": "math",
      "x": 40,
      "y": 6224,
      "src": "Rd_mflt := 0.90*F_y*n_et*Z_1 = tonf*m"
    },
    {
      "id": "Rd_mrot",
      "kind": "math",
      "x": 40,
      "y": 6272,
      "src": "Rd_mrot := 0.75*F_u*n_et*Zn_1 = tonf*m"
    },
    {
      "id": "Rd_mfla",
      "kind": "math",
      "x": 40,
      "y": 6320,
      "src": "Rd_mfla := 0.90*F_y*Z_a = tonf*m"
    },
    {
      "id": "Rd_mroa",
      "kind": "math",
      "x": 40,
      "y": 6368,
      "src": "Rd_mroa := 0.75*F_u*Zn_a = tonf*m"
    },
    {
      "id": "v_mrot",
      "kind": "math",
      "x": 40,
      "y": 6416,
      "src": "Rd_mrot >= M_ut ="
    },
    {
      "id": "v_mroa",
      "kind": "math",
      "x": 40,
      "y": 6464,
      "src": "Rd_mroa >= M_ua ="
    },
