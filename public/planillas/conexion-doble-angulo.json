      "id": "u_mflt",
      "kind": "math",
      "x": 40,
      "y": 6512,
      "src": "u_mflt := M_ut/Rd_mflt ="
    },
    {
      "id": "u_mrot",
      "kind": "math",
      "x": 40,
      "y": 6560,
      "src": "u_mrot := M_ut/Rd_mrot ="
    },
    {
      "id": "u_mroa",
      "kind": "math",
      "x": 40,
      "y": 6608,
      "src": "u_mroa := M_ua/Rd_mroa ="
    },
    {
      "id": "t6c",
      "kind": "text",
      "x": 40,
      "y": 6656,
      "src": "Los pernos lo toman como grupo excéntrico — método elástico de vectores, conservador, con e = el brazo completo"
    },
    {
      "id": "y_max",
      "kind": "math",
      "x": 40,
      "y": 6704,
      "src": "y_max := 3*s/2 = cm"
    },
    {
      "id": "J_b",
      "kind": "math",
      "x": 40,
      "y": 6752,
      "src": "J_b := 2*((s/2)^2 + y_max^2) = cm^2"
    },
    {
      "id": "r_v",
      "kind": "math",
      "x": 40,
      "y": 6800,
      "src": "r_v := V_u/n_b = tonf"
    },
    {
      "id": "r_mt",
      "kind": "math",
      "x": 40,
      "y": 6848,
      "src": "r_mt := M_ut*y_max/J_b = tonf"
    },
    {
      "id": "r_ma",
      "kind": "math",
      "x": 40,
      "y": 6896,
      "src": "r_ma := M_ua*y_max/J_b = tonf"
    },
    {
      "id": "r_bt",
      "kind": "math",
      "x": 40,
      "y": 6944,
      "src": "r_bt := sqrt(r_mt^2 + r_v^2) = tonf"
    },
    {
      "id": "r_ba",
