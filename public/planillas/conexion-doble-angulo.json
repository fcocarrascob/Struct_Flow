      "x": 40,
      "y": 6992,
      "src": "r_ba := sqrt(r_ma^2 + r_v^2) = tonf"
    },
    {
      "id": "u_exct",
      "kind": "math",
      "x": 40,
      "y": 7040,
      "src": "u_exct := r_bt/Rd_b1t ="
