{
  "version": 1,
  "meta": {
    "titulo": "El sitio del galpón del altiplano — K_zt, K_e y el q_h por NCh 432:2025",
    "ficha": "struct_pad/src/content/apuntes/ejemplo-galpon-altiplano-viento-sitio-nch432.mdx",
    "esperadoFalso": {}
  },
  "regions": [
    { "id": "s-00", "kind": "text", "x": 40, "y": 40, "src": "━━ DATOS · SITIO (NCh 432:2025, 3.ª ed.) ━━" },
    { "id": "s-01", "kind": "math", "x": 40, "y": 86, "src": "V_b := 30 m/s" },
    { "id": "s-02", "kind": "math", "x": 40, "y": 132, "src": "p0_tab := 552 N/m^2" },
    { "id": "s-03", "kind": "math", "x": 40, "y": 178, "src": "I_imp := 1.00" },
    { "id": "s-04", "kind": "math", "x": 40, "y": 224, "src": "Kz := 0.95" },
    { "id": "s-05", "kind": "math", "x": 40, "y": 270, "src": "Kd := 0.85" },
    { "id": "s-06", "kind": "math", "x": 40, "y": 316, "src": "z_e := 3800 m" },
    { "id": "s-07", "kind": "math", "x": 40, "y": 362, "src": "h_al := 8.0 m" },
    { "id": "s-08", "kind": "math", "x": 40, "y": 408, "src": "theta := 10 deg" },
    { "id": "s-09", "kind": "text", "x": 40, "y": 454, "src": "V_b y p0_tab: Tabla 1, zona I-B · I_imp: Tabla 2, categoría II · Kz: Tabla 5, exp. C a 8 m · Kd: Tabla 3" },

    { "id": "c-00", "kind": "text", "x": 40, "y": 500, "src": "━━ DATOS · EL CERRO (levantamiento topográfico, dato de proyecto) ━━" },
    { "id": "c-01", "kind": "math", "x": 40, "y": 546, "src": "H_c := 40 m" },
    { "id": "c-02", "kind": "math", "x": 40, "y": 592, "src": "Lh := 120 m" },
    { "id": "c-03", "kind": "math", "x": 40, "y": 638, "src": "x_pos := 0 m" },
    { "id": "c-04", "kind": "text", "x": 40, "y": 684, "src": "Figura 3, fila CIMA 2D y columna exposición C. Cambiar estas tres cifras es cambiar de fila:" },
    { "id": "c-05", "kind": "math", "x": 40, "y": 730, "src": "K1_r := 1.45" },
    { "id": "c-06", "kind": "math", "x": 40, "y": 776, "src": "gam := 3" },
    { "id": "c-07", "kind": "math", "x": 40, "y": 822, "src": "mu_at := 1.5" },

    { "id": "a-00", "kind": "text", "x": 40, "y": 868, "src": "━━ ¿APLICA EL K_zt? · §5.6.1 EXIGE LAS TRES CONDICIONES ━━" },
    { "id": "a-01", "kind": "math", "x": 40, "y": 914, "src": "razon := H_c/Lh =" },
    { "id": "v_cond2", "kind": "math", "x": 40, "y": 960, "src": "razon >= 0.2 =" },
    { "id": "v_cond3", "kind": "math", "x": 40, "y": 1006, "src": "H_c >= 4.5 m =" },
    { "id": "a-02", "kind": "text", "x": 40, "y": 1052, "src": "La condición 1 —estar en la mitad superior del accidente— es de posición y se declara, no se calcula." },

    { "id": "u-00", "kind": "text", "x": 40, "y": 1098, "src": "━━ DOS UMBRALES MÁS, QUE DECIDEN QUÉ CAMINO SE TOMA ━━" },
    { "id": "v_theta", "kind": "math", "x": 40, "y": 1144, "src": "theta <= 10 deg =" },
    { "id": "u-01", "kind": "text", "x": 40, "y": 1190, "src": "↑ §3.2: si se cumple, h del q_h es la altura de ALERO, no la altura media del techo." },
    { "id": "v_altitud", "kind": "math", "x": 40, "y": 1236, "src": "z_e > 1800 m =" },
    { "id": "u-02", "kind": "text", "x": 40, "y": 1282, "src": "↑ la Tabla 4 termina en 1 800 m: si se cumple, hay que salir a la fórmula de su Nota 2." },
    { "id": "v_tope", "kind": "math", "x": 40, "y": 1328, "src": "razon <= 0.5 =" },
    { "id": "u-03", "kind": "text", "x": 40, "y": 1374, "src": "↑ §5.6.2: si NO se cumple, K1 se evalúa con 0,5 y L_h se sustituye por 2H en K2 y K3." },

    { "id": "e-00", "kind": "text", "x": 40, "y": 1420, "src": "━━ EC. (1) DE §5.6.2 · K_zt = (1 + K1·K2·K3)² ━━" },
    { "id": "e-01", "kind": "program", "x": 40, "y": 1466, "src": "Lh_ef :=\n    if razon > 0.5\n        return 2 * H_c\n    else\n        return Lh" },
    { "id": "e-02", "kind": "math", "x": 40, "y": 1604, "src": "K1 := K1_r * min(razon, 0.5) =" },
    { "id": "e-03", "kind": "math", "x": 40, "y": 1650, "src": "K2 := 1 - abs(x_pos)/(mu_at * Lh_ef) =" },
    { "id": "e-04", "kind": "math", "x": 40, "y": 1696, "src": "K3 := exp(-gam * h_al / Lh_ef) =" },
    { "id": "e-05", "kind": "math", "x": 40, "y": 1742, "src": "Kzt := (1 + K1 * K2 * K3)^2 =" },

    { "id": "k-00", "kind": "text", "x": 40, "y": 1788, "src": "━━ K_e · TABLA 4, NOTA 2 ━━" },
    { "id": "k-01", "kind": "math", "x": 40, "y": 1834, "src": "z_adim := z_e / (1 m) =" },
    { "id": "k-02", "kind": "math", "x": 40, "y": 1880, "src": "Ke := exp(-0.000119 * z_adim) =" },

    { "id": "q-00", "kind": "text", "x": 40, "y": 1926, "src": "━━ EC. (2) DE §5.8.2 · q_z = 0,613·I·K_z·K_zt·K_e·V² · OJO: el K_d NO va acá ━━" },
    { "id": "q-01", "kind": "math", "x": 40, "y": 1972, "src": "coef613 := 0.613 N*s^2/m^4" },
    { "id": "q-02", "kind": "math", "x": 40, "y": 2018, "src": "p0 := coef613 * V_b^2 = N/m^2" },
    { "id": "q-03", "kind": "math", "x": 40, "y": 2064, "src": "qh := coef613 * I_imp * Kz * Kzt * Ke * V_b^2 = N/m^2" },
    { "id": "q-04", "kind": "text", "x": 40, "y": 2110, "src": "Segunda vía, independiente: partir del p0 tabulado de la Nota 1 de la Tabla 1." },
    { "id": "q-05", "kind": "math", "x": 40, "y": 2156, "src": "qh_via_p0 := p0_tab * Kz * Kzt * Ke = N/m^2" },
    { "id": "v_dos_vias", "kind": "math", "x": 40, "y": 2202, "src": "abs(qh_via_p0 - qh) < 1 N/m^2 =" },

    { "id": "x-00", "kind": "text", "x": 40, "y": 2248, "src": "━━ CONTRASTES CONTRA EL POST ━━" },
    { "id": "c_p0", "kind": "math", "x": 40, "y": 2294, "src": "abs(p0 - 551.7 N/m^2) < 0.05 N/m^2 =" },
    { "id": "c_ke", "kind": "math", "x": 40, "y": 2340, "src": "abs(Ke - 0.6362) < 0.00005 =" },
    { "id": "c_kzt", "kind": "math", "x": 40, "y": 2386, "src": "abs(Kzt - 1.9480) < 0.0005 =" },
    { "id": "c_neto", "kind": "math", "x": 40, "y": 2432, "src": "abs(Kzt * Ke - 1.2394) < 0.0005 =" },
    { "id": "c_qh", "kind": "math", "x": 40, "y": 2478, "src": "abs(qh - 649.58 N/m^2) < 0.05 N/m^2 =" },

    { "id": "t-00", "kind": "text", "x": 40, "y": 2524, "src": "━━ LA TESIS · EL MISMO CERRO, TRES FILAS DE LA FIGURA 3 ━━" },
    { "id": "t-01", "kind": "text", "x": 40, "y": 2570, "src": "Misma H, mismo L_h, misma posición y misma exposición: solo cambian K1/(H/L_h) y γ." },
    { "id": "t-02", "kind": "program", "x": 40, "y": 2616, "src": "kzt_de(k1r, gamma_f) :=\n    k1 := k1r * min(razon, 0.5)\n    k2 := 1 - abs(x_pos)/(mu_at * Lh_ef)\n    k3 := exp(-gamma_f * h_al / Lh_ef)\n    return (1 + k1 * k2 * k3)^2" },
    { "id": "t-03", "kind": "math", "x": 40, "y": 2754, "src": "Kzt_cima := kzt_de(1.45, 3) =" },
    { "id": "t-04", "kind": "math", "x": 40, "y": 2800, "src": "Kzt_col3d := kzt_de(1.05, 4) =" },
    { "id": "t-05", "kind": "math", "x": 40, "y": 2846, "src": "Kzt_escarpe := kzt_de(0.85, 2.5) =" },
    { "id": "t-06", "kind": "math", "x": 40, "y": 2892, "src": "rango := Kzt_cima/Kzt_escarpe - 1 =" },
    { "id": "c_rango", "kind": "math", "x": 40, "y": 2938, "src": "abs(rango - 0.2673) < 0.001 =" },
    { "id": "t-07", "kind": "text", "x": 40, "y": 2984, "src": "El μ del escarpamiento a sotavento es 4 y no 1,5, pero con x = 0 el K2 vale 1 en los tres casos." },

    { "id": "p-00", "kind": "text", "x": 40, "y": 3030, "src": "━━ EL ESCALÓN DE §5.6.1 · UN UMBRAL, NO UNA TRANSICIÓN ━━" },
    { "id": "p-01", "kind": "math", "x": 40, "y": 3076, "src": "Lh_umbral := H_c/0.2 = m" },
    { "id": "p-02", "kind": "program", "x": 40, "y": 3122, "src": "kzt_lh(lh_v) :=\n    r := H_c / lh_v\n    if r < 0.2\n        return 1\n    lhe := lh_v\n    if r > 0.5\n        lhe := 2 * H_c\n    k1 := K1_r * min(r, 0.5)\n    k3 := exp(-gam * h_al / lhe)\n    return (1 + k1 * k3)^2" },
    { "id": "p-03", "kind": "math", "x": 40, "y": 3370, "src": "Kzt_200 := kzt_lh(200 m) =" },
    { "id": "p-04", "kind": "math", "x": 40, "y": 3416, "src": "Kzt_201 := kzt_lh(201 m) =" },
    { "id": "p-05", "kind": "math", "x": 40, "y": 3462, "src": "salto := Kzt_200/Kzt_201 - 1 =" },
    { "id": "c_salto", "kind": "math", "x": 40, "y": 3508, "src": "abs(salto - 0.5806) < 0.001 =" },
    { "id": "p-06", "kind": "text", "x": 40, "y": 3554, "src": "Un metro de diferencia al medir el L_h en el plano, y el factor pasa de 1,58 a 1,00." },

    { "id": "o-00", "kind": "text", "x": 40, "y": 3600, "src": "━━ QUIÉN OLVIDA QUÉ ━━" },
    { "id": "o-01", "kind": "math", "x": 40, "y": 3646, "src": "qh_sin_kzt := coef613 * I_imp * Kz * Ke * V_b^2 = N/m^2" },
    { "id": "o-02", "kind": "math", "x": 40, "y": 3692, "src": "frac := qh_sin_kzt/qh =" },
    { "id": "c_frac", "kind": "math", "x": 40, "y": 3738, "src": "abs(frac - 0.5133) < 0.001 =" },
    { "id": "o-03", "kind": "text", "x": 40, "y": 3784, "src": "Quien aplica el K_e y olvida el K_zt diseña con la mitad de la presión que corresponde." }
  ]
}
