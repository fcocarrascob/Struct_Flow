      "id": "r031",
      "kind": "text",
      "x": 40,
      "y": 1584,
      "src": "amp = 0,7·R1, con R = 5 y R1 = 4,0"
    },
    {
      "id": "r032",
      "kind": "math",
      "x": 40,
      "y": 1632,
      "src": "T_ye := R_yt*F_yt*A_gt = tonf"
    },
