      "id": "v_vb",
      "kind": "math",
      "x": 40,
      "y": 5472,
      "src": "Rd_vb >= V_i ="
    },
    {
      "id": "r093",
      "kind": "math",
      "x": 40,
      "y": 5520,
      "src": "sig_b := N_i/A_bo = kgf/cm^2"
    },
