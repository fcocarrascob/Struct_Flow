   "x": 40,
   "y": 7008,
   "src": "u_B <= 1 ="
  },
  {
   "id": "r124",
   "kind": "text",
   "x": 40,
   "y": 7072,
   "src": "━━ 7 · LA PALANCA: CUÁNTO COMPRA EL ARRIOSTRE ━━"
  },
  {
   "id": "r125",
   "kind": "math",
   "x": 40,
   "y": 7120,
   "src": "raz := Rd_B/Rd_A ="
  },
