      "x": 40,
      "y": 1936,
      "src": "↑ Tabla 6, exposiciones B · C · D, en el orden α · z_g · z_mín, con z en m."
    },
    {
      "id": "r018",
      "kind": "math",
      "x": 40,
      "y": 1984,
      "src": "par_ex := par_expo(expo)"
    },
    {
      "id": "r019",
      "kind": "math",
      "x": 40,
      "y": 2032,
      "src": "alfa := par_ex[1] ="
    },
    {
      "id": "r020",
      "kind": "math",
      "x": 40,
      "y": 2080,
      "src": "z_g := par_ex[2] * (1 m) = m"
    },
    {
      "id": "r021",
      "kind": "math",
      "x": 40,
      "y": 2128,
      "src": "z_min := par_ex[3] * (1 m) = m"
    },
    {
      "id": "v_expo_valida",
      "kind": "math",
      "x": 40,
      "y": 2176,
      "src": "v_expo_valida := expo >= 1 and expo <= 3 and round(expo) == expo ="
    },
    {
      "id": "r022",
      "kind": "math",
      "x": 40,
      "y": 2224,
      "src": "h_cum := h_al + B_tr/2 * tan(theta) = m"
    },
    {
      "id": "r023",
      "kind": "program",
      "x": 40,
      "y": 2272,
      "src": "altura_ref() :=\n    if theta <= 10 deg\n        return h_al\n    return (h_al + h_cum)/2"
    },
    {
      "id": "r024",
      "kind": "text",
      "x": 40,
      "y": 2400,
      "src": "↑ Figura 4: h es la altura media del techo, salvo con θ ≤ 10°, en que se usa la del alero."
    },
    {
      "id": "r025",
      "kind": "math",
      "x": 40,
      "y": 2448,
      "src": "h_m := altura_ref() = m"
    },
    {
      "id": "r026",
      "kind": "math",
      "x": 40,
      "y": 2496,
      "src": "z_K := min(max(h_m, z_min), z_g) = m"
    },
    {
      "id": "r027",
      "kind": "math",
      "x": 40,
      "y": 2544,
      "src": "K_z := 2.41 * (z_K/z_g)^(2/alfa) ="
    },
    {
      "id": "r028",
      "kind": "text",
      "x": 40,
      "y": 2592,
      "src": "↑ Tabla 5, Nota 1, con z acotado a z_mín (Nota 3) y a z_g (Nota 4)."
    },
    {
      "id": "r029",
      "kind": "math",
      "x": 40,
      "y": 2640,
      "src": "K_e := exp(-0.000119 * z_e/(1 m)) ="
    },
    {
      "id": "r030",
      "kind": "text",
      "x": 40,
      "y": 2688,
      "src": "↑ Tabla 4, con la altitud del sitio."
    },
    {
      "id": "r031",
      "kind": "math",
      "x": 40,
      "y": 2736,
      "src": "coef613 := 0.613 N*s^2/m^4"
    },
    {
      "id": "r032",
      "kind": "math",
      "x": 40,
      "y": 2784,
      "src": "q_h := coef613 * I_w * K_z * K_zt * K_e * V_b^2 = kgf/m^2"
    },
    {
      "id": "r033",
      "kind": "text",
      "x": 40,
      "y": 2832,
      "src": "━━ 2 — PRESIÓN INTERNA · §5.10, §5.11, Tabla 7 y Ec. (3) ━━"
    },
    {
      "id": "r034",
      "kind": "math",
      "x": 40,
      "y": 2880,
      "src": "GCpi_tab := [0.18, 0.55, 0.18]"
    },
    {
      "id": "r035",
      "kind": "text",
      "x": 40,
      "y": 2928,
      "src": "↑ Tabla 7, en el orden cerrado · parcialmente cerrado · parcialmente abierto. El edificio abierto queda fuera de la hoja."
    },
    {
      "id": "v_cerr_valida",
      "kind": "math",
      "x": 40,
      "y": 2976,
      "src": "v_cerr_valida := cerr >= 1 and cerr <= 3 and round(cerr) == cerr ="
    },
    {
      "id": "v_aberturas",
      "kind": "math",
      "x": 40,
      "y": 3024,
      "src": "v_aberturas := cerr != 2 or (A_og > 0 m^2 and V_i > 0 m^3) ="
    },
    {
      "id": "r036",
      "kind": "program",
      "x": 40,
      "y": 3072,
      "src": "reduccion_Ri() :=\n    if cerr != 2\n        return 1\n    return min(0.5*(1 + 1/sqrt(1 + V_i/(6950 m * A_og))), 1)"
    },
    {
      "id": "r037",
      "kind": "text",
      "x": 40,
      "y": 3200,
      "src": "↑ Ec. (3): R_i solo reduce al parcialmente cerrado de un único volumen sin particiones."
    },
    {
      "id": "r038",
      "kind": "math",
      "x": 40,
      "y": 3248,
      "src": "R_i := reduccion_Ri() ="
    },
    {
      "id": "r039",
      "kind": "math",
      "x": 40,
      "y": 3296,
      "src": "GC_pi := GCpi_tab[min(max(round(cerr), 1), 3)] * R_i ="
    },
    {
      "id": "r040",
      "kind": "text",
      "x": 40,
      "y": 3344,
      "src": "↑ Tabla 7, Nota 3: se evalúan los dos signos, +GC_pi y −GC_pi, en todas las superficies internas."
    },
    {
      "id": "r041",
      "kind": "text",
      "x": 40,
      "y": 3392,
      "src": "━━ 3 — ÁREA EFECTIVA · §3.4 y §9.2.3 ━━"
    },
    {
      "id": "r042",
      "kind": "math",
      "x": 40,
      "y": 3440,
      "src": "A_cos := L_cos * max(s_cos, L_cos/3) = m^2"
    },
    {
      "id": "r043",
      "kind": "math",
      "x": 40,
      "y": 3488,
      "src": "A_lar := L_lar * max(s_lar, L_lar/3) = m^2"
    },
    {
      "id": "r044",
      "kind": "text",
      "x": 40,
      "y": 3536,
      "src": "↑ §3.4: la luz por un ancho efectivo que no necesita ser menor que un tercio de la luz. Es el\nárea con que se entra a las curvas, no el área tributaria."
    },
    {
      "id": "v_trib_cos",
      "kind": "math",
      "x": 40,
      "y": 3616,
      "src": "v_trib_cos := L_cos * s_cos <= 65 m^2 ="
    },
    {
      "id": "v_trib_lar",
      "kind": "math",
      "x": 40,
      "y": 3664,
      "src": "v_trib_lar := L_lar * s_lar <= 65 m^2 ="
    },
    {
      "id": "r045",
      "kind": "text",
      "x": 40,
      "y": 3712,
      "src": "↑ §9.2.3: con más de 65 m² de área tributaria, el elemento se puede diseñar como SPRFV."
    },
    {
      "id": "r046",
      "kind": "text",
      "x": 40,
      "y": 3760,
      "src": "━━ 4 — ZONAS · Figuras 24 y 26 a 29 ━━"
    },
    {
      "id": "r047",
      "kind": "program",
      "x": 40,
      "y": 3808,
      "src": "figura_de() :=\n    if theta <= 7 deg\n        return 1\n    else if theta <= 20 deg\n        return 2\n    else if theta <= 27 deg\n        return 3\n    return 4"
    },
    {
      "id": "r048",
      "kind": "math",
      "x": 40,
      "y": 4016,
      "src": "fig := figura_de() ="
    },
    {
      "id": "r049",
      "kind": "text",
      "x": 40,
      "y": 4064,
      "src": "↑ 1: Figura 26 (θ ≤ 7°) · 2: Figura 27 (7° < θ ≤ 20°) · 3: Figura 28 (20° < θ ≤ 27°) ·\n4: Figura 29 (27° < θ ≤ 45°)."
    },
    {
      "id": "r050",
      "kind": "math",
      "x": 40,
      "y": 4144,
      "src": "B_min := min(B_tr, L_lg) = m"
    },
    {
      "id": "r051",
      "kind": "math",
      "x": 40,
      "y": 4192,
      "src": "a_mur := max(min(0.1*B_min, 0.4*h_m), max(0.04*B_min, 0.9 m)) = m"
    },
    {
      "id": "r052",
      "kind": "math",
      "x": 40,
      "y": 4240,
      "src": "a_tec := max(min(0.1*B_min, 0.4*h_al), max(0.04*B_min, 0.9 m)) = m"
    },
    {
      "id": "r053",
      "kind": "text",
      "x": 40,
      "y": 4288,
      "src": "↑ Ancho de las zonas de borde y esquina. En los muros h es la altura media del techo (Figura 24);\nen las Figuras 26 a 29 es la del alero. La envolvente no depende de a: se informa para ubicar las\nzonas en el modelo."
    },
    {
      "id": "r054",
      "kind": "text",
      "x": 40,
      "y": 4400,
      "src": "━━ 5 — COEFICIENTES (GC_p) · Figuras 24 y 26 a 29 ━━"
    },
    {
      "id": "r055",
      "kind": "program",
      "x": 40,
      "y": 4448,
      "src": "curva(Aa, A1, g1, A2, g2) :=\n    if Aa <= A1\n        return g1\n    if Aa >= A2\n        return g2\n    return g1 + (g2 - g1)*log10(Aa/A1)/log10(A2/A1)"
    },
    {
      "id": "r056",
      "kind": "text",
      "x": 40,
      "y": 4624,
      "src": "↑ Las curvas son rectas en escala logarítmica del área: constantes fuera de sus quiebres."
    },
    {
      "id": "r057",
      "kind": "program",
      "x": 40,
      "y": 4672,
      "src": "gcp_muro(Aa) :=\n    z4 := curva(Aa, 0.9, -1.1, 46.5, -0.8)\n    z5 := curva(Aa, 0.9, -1.4, 46.5, -0.8)\n    zp := curva(Aa, 0.9, 1.0, 46.5, 0.7)\n    return [z4, z5, zp]"
    },
    {
      "id": "r058",
      "kind": "text",
      "x": 40,
      "y": 4816,
      "src": "↑ Figura 24, en el orden zona 4 · zona 5 · positiva (4 y 5), con A en m²."
    },
    {
      "id": "r059",
      "kind": "program",
      "x": 40,
      "y": 4864,
      "src": "gcp_techo(Aa) :=\n    if fig == 1\n        return [curva(Aa, 0.9, -1.7, 46.5, -1.0), curva(Aa, 0.9, -2.3, 46.5, -1.4), curva(Aa, 0.9, -3.2, 46.5, -1.4), curva(Aa, 0.9, 0.3, 9.3, 0.2)]\n    else if fig == 2\n        return [curva(Aa, 0.9, -2.0, 27.9, -0.5), curva(Aa, 0.9, -2.7, 18.6, -1.0), curva(Aa, 0.9, -3.6, 9.3, -1.8), curva(Aa, 0.9, 0.6, 18.6, 0.3)]\n    else if fig == 3\n        return [curva(Aa, 0.9, -1.5, 18.6, -0.8), curva(Aa, 0.9, -2.5, 9.3, -1.2), curva(Aa, 0.9, -3.0, 9.3, -1.4), curva(Aa, 0.9, 0.6, 18.6, 0.3)]\n    return [curva(Aa, 0.9, -1.8, 9.3, -0.8), curva(Aa, 0.9, -2.0, 18.6, -1.0), curva(Aa, 0.9, -2.5, 18.6, -1.0), curva(Aa, 0.9, 0.9, 18.6, 0.5)]"
    },
    {
      "id": "r060",
      "kind": "text",
      "x": 40,
      "y": 5072,
      "src": "↑ Figuras 26 a 29, en el orden zona 1 · zona 2 · zona 3 · positiva (todas las zonas). La zona 1'\nde la Figura 26 es menos severa que la 1 y no entra en la envolvente."
    },
    {
      "id": "r061",
      "kind": "program",
      "x": 40,
      "y": 5152,
      "src": "red_muro() :=\n    if theta <= 10 deg\n        return 0.9\n    return 1.0"
    },
    {
      "id": "r062",
      "kind": "math",
      "x": 40,
      "y": 5280,
      "src": "f_mur := red_muro() ="
    },
    {
      "id": "r063",
      "kind": "text",
      "x": 40,
      "y": 5328,
      "src": "↑ Figura 24, Nota 5: los (GC_p) de muros se reducen un 10 % con θ ≤ 10°."
    },
    {
      "id": "r064",
      "kind": "math",
      "x": 40,
      "y": 5376,
      "src": "gt := gcp_techo(A_cos/(1 m^2)) ="
    },
    {
      "id": "r065",
      "kind": "math",
      "x": 40,
      "y": 5424,
      "src": "gm := f_mur * gcp_muro(A_lar/(1 m^2)) ="
    },
    {
      "id": "r066",
      "kind": "math",
      "x": 40,
      "y": 5472,
      "src": "GCt_suc := min(gt[1], gt[2], gt[3]) ="
    },
    {
      "id": "r067",
      "kind": "math",
      "x": 40,
      "y": 5520,
      "src": "GCt_pre := gt[4] ="
    },
    {
      "id": "r068",
      "kind": "math",
      "x": 40,
      "y": 5568,
      "src": "GCm_suc := min(gm[1], gm[2]) ="
    },
    {
      "id": "r069",
      "kind": "math",
      "x": 40,
      "y": 5616,
      "src": "GCm_pre := gm[3] ="
    },
    {
      "id": "r070",
      "kind": "text",
      "x": 40,
      "y": 5664,
      "src": "↑ ENVOLVENTE: el (GC_p) más negativo de todas las zonas y el positivo. Una sección para todo el\ntecho y otra para todos los muros, del lado seguro."
    },
    {
      "id": "r071",
      "kind": "text",
      "x": 40,
      "y": 5744,
      "src": "━━ 6 — PRESIONES DE DISEÑO · §9.3.2, Ec. (19), y §9.2.2 ━━"
    },
    {
      "id": "r072",
      "kind": "math",
      "x": 40,
      "y": 5792,
      "src": "qK := q_h * K_d = kgf/m^2"
    },
    {
      "id": "r073",
      "kind": "text",
      "x": 40,
      "y": 5840,
      "src": "↑ Ec. (19): p = q_h·K_d·[(GC_p) − (GC_pi)]. La succión máxima va con +GC_pi y la presión máxima\ncon −GC_pi. Signo + hacia la superficie y − alejándose de ella."
    },
    {
      "id": "r074",
      "kind": "math",
      "x": 40,
      "y": 5920,
      "src": "pc_suc := qK*(GCt_suc - GC_pi) = kgf/m^2"
    },
    {
      "id": "r075",
      "kind": "math",
      "x": 40,
      "y": 5968,
      "src": "pc_pre := qK*(GCt_pre + GC_pi) = kgf/m^2"
    },
    {
      "id": "r076",
      "kind": "math",
      "x": 40,
      "y": 6016,
      "src": "pl_suc := qK*(GCm_suc - GC_pi) = kgf/m^2"
    },
    {
      "id": "r077",
      "kind": "math",
      "x": 40,
      "y": 6064,
      "src": "pl_pre := qK*(GCm_pre + GC_pi) = kgf/m^2"
    },
    {
      "id": "r078",
      "kind": "math",
      "x": 40,
      "y": 6112,
      "src": "p_min := 0.25 kN/m^2 = kgf/m^2"
    },
    {
      "id": "v_min_cos",
      "kind": "math",
      "x": 40,
      "y": 6160,
      "src": "v_min_cos := -pc_suc >= p_min and pc_pre >= p_min ="
    },
    {
      "id": "v_min_lar",
      "kind": "math",
      "x": 40,
      "y": 6208,
      "src": "v_min_lar := -pl_suc >= p_min and pl_pre >= p_min ="
    },
    {
      "id": "r079",
      "kind": "text",
      "x": 40,
      "y": 6256,
      "src": "↑ §9.2.2: ninguna presión neta de diseño puede ser menor que 0,25 kN/m², en cualquier sentido."
    },
    {
      "id": "r080",
      "kind": "math",
      "x": 40,
      "y": 6304,
      "src": "p_cos_suc := min(pc_suc, -p_min) = kgf/m^2"
    },
    {
      "id": "r081",
      "kind": "math",
      "x": 40,
      "y": 6352,
      "src": "p_cos_pre := max(pc_pre, p_min) = kgf/m^2"
    },
    {
      "id": "r082",
      "kind": "math",
      "x": 40,
      "y": 6400,
      "src": "p_lar_suc := min(pl_suc, -p_min) = kgf/m^2"
    },
    {
      "id": "r083",
      "kind": "math",
      "x": 40,
      "y": 6448,
      "src": "p_lar_pre := max(pl_pre, p_min) = kgf/m^2"
    },
    {
      "id": "r084",
      "kind": "text",
      "x": 40,
      "y": 6496,
      "src": "↑ Las presiones de diseño de las costaneras y de los largueros, con el mínimo aplicado. Se cargan\ncomo presión normal a la cubierta o al muro sobre el ancho tributario de cada elemento."
    },
    {
      "id": "r085",
      "kind": "program",
      "x": 40,
      "y": 6576,
      "src": "zona_suc_techo() :=\n    if gt[3] <= gt[1] and gt[3] <= gt[2]\n        return \"zona 3\"\n    else if gt[2] <= gt[1]\n        return \"zona 2\"\n    return \"zona 1\""
    },
    {
      "id": "r086",
      "kind": "math",
      "x": 40,
      "y": 6752,
      "src": "zona_cos := zona_suc_techo()"
    },
    {
      "id": "r087",
      "kind": "program",
      "x": 40,
      "y": 6800,
      "src": "nombre_figura() :=\n    nombres := [\"Figura 26\", \"Figura 27\", \"Figura 28\", \"Figura 29\"]\n    return nombres[fig]"
    },
    {
      "id": "r088",
      "kind": "math",
      "x": 40,
      "y": 6912,
      "src": "rot_fig := nombre_figura()"
    },
    {
      "id": "r089",
      "kind": "text",
      "x": 40,
      "y": 6960,
      "src": "━━ RESUMEN ━━"
    },
    {
      "id": "v_parte1",
      "kind": "math",
      "x": 40,
      "y": 7008,
      "src": "v_parte1 := h_m <= 18.3 m ="
    },
    {
      "id": "v_theta_rango",
      "kind": "math",
      "x": 40,
      "y": 7056,
      "src": "v_theta_rango := theta >= 0 deg and theta <= 45 deg ="
    },
    {
      "id": "v_geometria",
      "kind": "math",
      "x": 40,
      "y": 7104,
      "src": "v_geometria := B_tr > 0 m and L_lg > 0 m and h_al > 0 m and L_cos > 0 m and s_cos > 0 m and L_lar > 0 m and s_lar > 0 m ="
    },
    {
      "id": "v_global",
      "kind": "math",
      "x": 40,
      "y": 7152,
      "src": "v_global := v_zona_valida and v_cat_valida and v_expo_valida and v_cerr_valida and v_aberturas and v_parte1 and v_theta_rango and v_geometria ="
    },
    {
      "id": "r090",
      "kind": "text",
      "x": 40,
      "y": 7200,
      "src": "━━ ESQUEMA · MAPEO A PÍXELES ━━",
      "imprimir": false
    },
    {
      "id": "r091",
      "kind": "math",
      "x": 40,
      "y": 7248,
      "src": "x_0 := 70",
      "imprimir": false
    },
    {
      "id": "r092",
      "kind": "math",
      "x": 40,
      "y": 7296,
      "src": "x_1 := 330",
      "imprimir": false
    },
    {
      "id": "r093",
      "kind": "math",
      "x": 40,
      "y": 7344,
      "src": "y_top := 90",
      "imprimir": false
    },
    {
      "id": "r094",
      "kind": "math",
      "x": 40,
      "y": 7392,
      "src": "y_bot := 330",
      "imprimir": false
    },
    {
      "id": "r095",
      "kind": "math",
      "x": 40,
      "y": 7440,
      "src": "g_top := -4",
      "imprimir": false
    },
    {
      "id": "r096",
      "kind": "math",
      "x": 40,
      "y": 7488,
      "src": "g_bot := 1.2",
      "imprimir": false
    },
    {
      "id": "r097",
      "kind": "program",
      "x": 40,
      "y": 7536,
      "src": "xl_px(Aa) :=\n    return x_0 + (log10(Aa) - log10(0.1))/(log10(100) - log10(0.1))*(x_1 - x_0)",
      "imprimir": false
    },
    {
      "id": "r098",
      "kind": "program",
      "x": 40,
      "y": 7616,
      "src": "yg_px(gv) :=\n    return y_top + (gv - g_top)/(g_bot - g_top)*(y_bot - y_top)",
      "imprimir": false
    },
    {
      "id": "r099",
      "kind": "program",
      "x": 40,
      "y": 7696,
