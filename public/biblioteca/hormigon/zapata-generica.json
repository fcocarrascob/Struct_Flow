   "x": 40,
   "y": 1352,
   "src": "Msc_X := 0 kN*m"
  },
  {
   "id": "in_Mu_sup",
   "kind": "math",
   "x": 40,
   "y": 1400,
   "src": "Mu_sup := 49.2 kN*m"
  },
  {
   "id": "in_alfa_s",
   "kind": "math",
   "x": 40,
   "y": 1448,
   "src": "alfa_s := 40"
  },
  {
   "id": "r030",
   "kind": "text",
   "x": 40,
   "y": 1496,
   "src": "━━ 1 — CANTOS, SECCIONES CRÍTICAS Y FACTORES · ACI 318-25 §13.2.7, §13.3.1.2 y Tabla 21.2.1 ━━"
  },
  {
   "id": "r031",
   "kind": "text",
   "x": 40,
   "y": 1544,
   "src": "Tabla 13.2.7.1: el momento se toma en la CARA del pedestal; §13.2.7.2: el corte en una dirección\na d de la cara y el punzonamiento a d/2. Tabla 21.2.1: φ = 0,90 en tracción (a) y 0,75 en corte (e).\nd_Y es el canto útil de las barras paralelas a Y, que son las de la capa inferior y resisten Mu_Y."
  },
  {
   "id": "r032",
   "kind": "math",
   "x": 40,
   "y": 1640,
   "src": "bw := 1000 mm"
  },
  {
   "id": "r033",
   "kind": "math",
   "x": 40,
   "y": 1688,
   "src": "fc_n := fc/(1 MPa) ="
  },
  {
   "id": "r034",
   "kind": "math",
   "x": 40,
   "y": 1736,
   "src": "fy_n := fy/(1 MPa) ="
  },
  {
   "id": "r035",
   "kind": "math",
   "x": 40,
   "y": 1784,
   "src": "phi_flex := 0.90"
  },
  {
   "id": "r036",
   "kind": "math",
   "x": 40,
   "y": 1832,
   "src": "phi_corte := 0.75"
  },
  {
   "id": "r037",
   "kind": "math",
   "x": 40,
   "y": 1880,
   "src": "d_Y := hzap - recub - db/2 = mm"
  },
  {
   "id": "r038",
   "kind": "math",
   "x": 40,
   "y": 1928,
   "src": "d_X := hzap - recub - db - db/2 = mm"
  },
  {
   "id": "r039",
   "kind": "math",
   "x": 40,
   "y": 1976,
   "src": "d_pun := (d_Y + d_X)/2 = mm"
  },
  {
   "id": "v_canto_min",
   "kind": "math",
   "x": 40,
   "y": 2024,
   "src": "v_canto_min := d_Y >= 150 mm ="
  },
  {
   "id": "v_X_es_corta",
   "kind": "math",
   "x": 40,
   "y": 2072,
   "src": "v_X_es_corta := ZAP_X <= ZAP_Y ="
  },
  {
   "id": "r042",
   "kind": "text",
   "x": 40,
   "y": 2120,
   "src": "━━ 2 — FLEXIÓN · ACI 318-25 §13.3.3, §8.6.1.1 y §22.2 ━━"
  },
  {
   "id": "r043",
   "kind": "text",
   "x": 40,
   "y": 2168,
   "src": "La armadura requerida sale del equilibrio del bloque rectangular con φ = 0,90, y se contrasta\ncontra el mínimo de §8.6.1.1 —al que remite §13.3.3.1—, que es 0,0018 del área BRUTA y en la\nedición 25 ya no depende de fy. La sección tiene que quedar controlada por tracción: ε_t se juzga\ncon la dirección de menor canto, contra ε_ty + 0,003 y con Es = 200.000 MPa (Tabla 22.2.2.4.3 y §21.2.2)."
  },
  {
   "id": "r044",
   "kind": "program",
   "x": 40,
   "y": 2288,
   "src": "As_req(Mu, d) := (0.85*fc_n/fy_n)*(1 - sqrt(1 - 2*(Mu/(phi_flex*bw*d^2))/(0.85*fc_n*(1 MPa))))*bw*d"
  },
  {
   "id": "r045",
   "kind": "math",
   "x": 40,
   "y": 2336,
   "src": "As_Y_req := As_req(Mu_Y, d_Y) = mm^2"
  },
  {
   "id": "r046",
   "kind": "math",
   "x": 40,
   "y": 2384,
   "src": "As_X_req := As_req(Mu_X, d_X) = mm^2"
  },
  {
   "id": "r047",
   "kind": "math",
   "x": 40,
   "y": 2432,
   "src": "As_min := 0.0018*bw*hzap = mm^2"
  },
  {
   "id": "r048",
   "kind": "math",
   "x": 40,
   "y": 2480,
   "src": "As_Y := max(As_Y_req, As_min) = mm^2"
  },
  {
   "id": "r049",
   "kind": "math",
   "x": 40,
   "y": 2528,
   "src": "As_X := max(As_X_req, As_min) = mm^2"
  },
  {
   "id": "r050",
   "kind": "math",
   "x": 40,
   "y": 2576,
   "src": "beta1 := max(0.65, min(0.85, 0.85 - 0.05*(fc_n - 28)/7)) ="
  },
  {
   "id": "r051",
   "kind": "math",
   "x": 40,
   "y": 2624,
   "src": "a_blq := max(As_Y, As_X)*fy/(0.85*fc*bw) = mm"
  },
  {
   "id": "r052",
   "kind": "math",
   "x": 40,
   "y": 2672,
   "src": "xn := a_blq/beta1 = mm"
  },
  {
   "id": "r053",
   "kind": "math",
   "x": 40,
   "y": 2720,
   "src": "eps_t := 0.003*(d_X - xn)/xn ="
  },
  {
   "id": "v_tracc",
   "kind": "math",
   "x": 40,
   "y": 2768,
   "src": "v_tracc := eps_t >= fy_n/200000 + 0.003 ="
  },
  {
   "id": "r055",
   "kind": "text",
   "x": 40,
   "y": 2816,
   "src": "━━ 3 — ARMADURA PROVISTA, SEPARACIONES Y REPARTO EN BANDA · §8.7.2.2, §25.2.1 y Ec. (13.3.3.3) ━━"
  },
  {
   "id": "r056",
   "kind": "text",
   "x": 40,
   "y": 2864,
   "src": "Separación máxima en la sección crítica: el menor de 2h y 450 mm. Separación libre mínima: la\nmayor de 25 mm, db y 4/3 del agregado. La dirección CORTA no se reparte uniforme: γ_s de las\nbarras van en una banda central de ancho igual al lado corto, y aquí se resuelve en SEPARACIONES\npara no depender de un redondeo. En zapata cuadrada γ_s = 1 y no hay barras fuera de la banda."
  },
  {
   "id": "r057",
   "kind": "math",
   "x": 40,
   "y": 2984,
   "src": "As_prov := (pi/4*db^2)*(bw/sep) = mm^2"
  },
  {
   "id": "v_As_prov",
   "kind": "math",
   "x": 40,
   "y": 3032,
   "src": "v_As_prov := As_prov >= max(As_Y, As_X) ="
  },
  {
   "id": "r059",
   "kind": "math",
   "x": 40,
   "y": 3080,
   "src": "u_flexion := max(As_Y, As_X)/As_prov ="
  },
  {
   "id": "r060",
   "kind": "math",
   "x": 40,
   "y": 3128,
   "src": "sep_max := min(2*hzap, 450 mm) = mm"
  },
  {
   "id": "v_sep_max",
   "kind": "math",
   "x": 40,
   "y": 3176,
   "src": "v_sep_max := sep <= sep_max ="
  },
  {
   "id": "v_sep_min",
   "kind": "math",
   "x": 40,
   "y": 3224,
   "src": "v_sep_min := sep - db >= max(25 mm, db, (4/3)*d_agg) ="
  },
  {
   "id": "r063",
   "kind": "math",
   "x": 40,
   "y": 3272,
   "src": "gamma_s := 2/(ZAP_Y/ZAP_X + 1) ="
  },
  {
   "id": "r064",
   "kind": "math",
   "x": 40,
   "y": 3320,
   "src": "sep_banda := sep*ZAP_X/(gamma_s*ZAP_Y) = mm"
  },
  {
   "id": "r065",
   "kind": "math",
   "x": 40,
   "y": 3368,
   "src": "sep_fuera := sep*(ZAP_Y - ZAP_X)/(max(1 - gamma_s, 0.000001)*ZAP_Y) = mm"
  },
  {
   "id": "v_sep_banda",
   "kind": "math",
   "x": 40,
   "y": 3416,
   "src": "v_sep_banda := sep_banda <= sep_max ="
  },
  {
   "id": "v_sep_fuera",
   "kind": "math",
   "x": 40,
   "y": 3464,
   "src": "v_sep_fuera := sep_fuera <= sep_max ="
  },
  {
   "id": "r068",
   "kind": "text",
   "x": 40,
   "y": 3512,
   "src": "━━ 4 — ARMADURA SUPERIOR POR LEVANTAMIENTO · ACI 318-25 §18.13.2.5 y §7.6.1.1 ━━"
  },
  {
   "id": "r069",
   "kind": "text",
   "x": 40,
   "y": 3560,
   "src": "El §18.13.2.5 pide armadura de flexión en la cara superior para las combinaciones mayoradas en\nque el sismo produce levantamiento, y no menos que el mínimo de §7.6.1.1 (0,0018 del área bruta).\nSe verifica la cuantía adoptada contra el momento negativo del voladizo, que entra como dato."
  },
  {
   "id": "r070",
   "kind": "math",
   "x": 40,
   "y": 3656,
   "src": "d_sup := hzap - recub - db_sup/2 = mm"
  },
  {
   "id": "r071",
   "kind": "math",
   "x": 40,
   "y": 3704,
   "src": "As_sup := cuantia_sup*bw*hzap = mm^2"
  },
  {
   "id": "r072",
   "kind": "math",
   "x": 40,
   "y": 3752,
   "src": "a_sup := As_sup*fy/(0.85*fc*bw) = mm"
  },
  {
   "id": "r073",
   "kind": "math",
   "x": 40,
   "y": 3800,
   "src": "phiMn_sup := phi_flex*As_sup*fy*(d_sup - a_sup/2) = kN*m"
  },
  {
   "id": "v_sup_min",
   "kind": "math",
   "x": 40,
   "y": 3848,
   "src": "v_sup_min := cuantia_sup >= 0.0018 ="
  },
  {
   "id": "v_sup_flexion",
   "kind": "math",
   "x": 40,
   "y": 3896,
   "src": "v_sup_flexion := phiMn_sup >= Mu_sup ="
  },
  {
   "id": "r076",
   "kind": "text",
   "x": 40,
   "y": 3944,
   "src": "━━ 5 — CORTE EN UNA DIRECCIÓN · ACI 318-25 Tabla 22.5.5.1 ━━"
  },
  {
   "id": "r077",
   "kind": "text",
   "x": 40,
   "y": 3992,
   "src": "Sin armadura de corte (Av < Av,min) rige la ecuación (c), con el efecto de tamaño λ_s del\n§22.5.5.1.3 y ρ_w calculado con la armadura mínima exigida, que es cota inferior y no depende del\nreparto en banda. El §22.5.5.1.1 pone piso 0,083·λ·√f'c·bw·d —salvo tracción axial neta, que la\nhipótesis descarta, o §18.6.5.2 / §18.7.6.2.1— y techo 0,42·λ·√f'c·bw·d."
  },
  {
   "id": "r078",
   "kind": "program",
   "x": 40,
   "y": 4112,
   "src": "Vc_1d(d) := min(0.42, max(0.66*min(1, sqrt(2/(1 + d/(250 mm))))*(As_min/(bw*d))^(1/3), 0.083))*lam*sqrt(fc_n)*(1 MPa)*bw*d"
  },
  {
   "id": "r079",
   "kind": "math",
   "x": 40,
   "y": 4160,
   "src": "Vc_Y := Vc_1d(d_Y) = kN"
  },
  {
   "id": "r080",
   "kind": "math",
   "x": 40,
   "y": 4208,
   "src": "Vc_X := Vc_1d(d_X) = kN"
  },
  {
   "id": "r081",
   "kind": "math",
   "x": 40,
   "y": 4256,
   "src": "u_corte_Y := Vu_Y/(phi_corte*Vc_Y) ="
  },
  {
   "id": "r082",
   "kind": "math",
   "x": 40,
   "y": 4304,
   "src": "u_corte_X := Vu_X/(phi_corte*Vc_X) ="
  },
  {
   "id": "r083",
   "kind": "text",
   "x": 40,
   "y": 4352,
   "src": "━━ 6 — PUNZONAMIENTO · ACI 318-25 Tabla 22.6.5.2, §8.4.4.2.2 y §8.6.1.2 ━━"
  },
  {
   "id": "r084",
   "kind": "text",
   "x": 40,
   "y": 4400,
   "src": "Perímetro crítico a d/2 de la cara del pedestal. β es la relación de lados del área cargada\n(nota (ii) de la tabla). El §8.4.4.2.2 reparte el momento: γ_f va por flexión y γ_v = 1 − γ_f por\ncorte excéntrico; las dos direcciones se superponen en la esquina del perímetro, que es\nconservador. El §8.6.1.2 obliga a subir A_s,min si v_uv pasa φ·0,17·λ_s·λ·√f'c."
  },
  {
   "id": "r085",
   "kind": "math",
   "x": 40,
   "y": 4520,
   "src": "b1 := PED_Y + d_pun = mm"
  },
  {
   "id": "r086",
   "kind": "math",
   "x": 40,
   "y": 4568,
   "src": "b2 := PED_X + d_pun = mm"
  },
  {
   "id": "r087",
   "kind": "math",
   "x": 40,
   "y": 4616,
   "src": "bo := 2*b1 + 2*b2 = mm"
  },
  {
   "id": "r088",
   "kind": "math",
   "x": 40,
   "y": 4664,
   "src": "lam_sP := min(1, sqrt(2/(1 + d_pun/(250 mm)))) ="
  },
  {
   "id": "r089",
   "kind": "math",
   "x": 40,
   "y": 4712,
   "src": "beta_ped := max(PED_X, PED_Y)/min(PED_X, PED_Y) ="
  },
  {
   "id": "r090",
   "kind": "math",
   "x": 40,
   "y": 4760,
   "src": "vc := min(0.33, 0.17 + 0.33/beta_ped, 0.17 + 0.083*alfa_s*d_pun/bo)*lam_sP*lam*sqrt(fc_n)*(1 MPa) = MPa"
  },
  {
   "id": "r091",
   "kind": "math",
   "x": 40,
   "y": 4808,
   "src": "vuv := Vuv/(bo*d_pun) = MPa"
  },
  {
   "id": "r092",
   "kind": "program",
   "x": 40,
   "y": 4856,
   "src": "vum(ba, bb, Msc) := (1 - 1/(1 + (2/3)*sqrt(ba/bb)))*Msc*(ba/2)/(d_pun*ba^3/6 + ba*d_pun^3/6 + d_pun*bb*ba^2/2)"
  },
  {
   "id": "r093",
   "kind": "math",
   "x": 40,
   "y": 4904,
   "src": "vum_Y := vum(b1, b2, Msc_Y) = MPa"
  },
  {
   "id": "r094",
   "kind": "math",
   "x": 40,
   "y": 4952,
   "src": "vum_X := vum(b2, b1, Msc_X) = MPa"
  },
  {
   "id": "r095",
   "kind": "math",
   "x": 40,
   "y": 5000,
   "src": "vu := vuv + vum_Y + vum_X = MPa"
  },
  {
   "id": "r096",
   "kind": "math",
   "x": 40,
   "y": 5048,
   "src": "u_punz := vu/(phi_corte*vc) ="
  },
  {
   "id": "v_no_aplica_862",
   "kind": "math",
   "x": 40,
   "y": 5096,
   "src": "v_no_aplica_862 := vuv <= phi_corte*0.17*lam_sP*lam*sqrt(fc_n)*(1 MPa) ="
  },
  {
   "id": "r098",
   "kind": "text",
   "x": 40,
   "y": 5144,
   "src": "━━ RESUMEN ━━"
  },
  {
   "id": "r099",
   "kind": "math",
   "x": 40,
   "y": 5192,
   "src": "u_max := max(u_corte_Y, u_corte_X, u_punz) ="
  },
  {
   "id": "r100",
   "kind": "program",
   "x": 40,
   "y": 5240,
   "src": "gobierna :=\n    if u_max == u_corte_Y\n        return \"corte en una dirección en Y\"\n    else if u_max == u_corte_X\n        return \"corte en una dirección en X\"\n    else\n        return \"punzonamiento del pedestal sobre la zapata\""
  },
  {
   "id": "r101",
   "kind": "text",
   "x": 40,
   "y": 5432,
   "src": "El veredicto global suma la resistencia y el detallado: el uso de la armadura (provista contra\nexigida) no dice cuánto falta para agotar la sección, pero una separación fuera de norma o una\nsección sobrearmada invalidan la hoja igual que un uso mayor que 1."
  },
  {
   "id": "v_global",
   "kind": "math",
   "x": 40,
   "y": 5528,
   "src": "v_global := u_max <= 1 and v_canto_min and v_tracc and v_As_prov and v_sep_max and v_sep_min and v_sep_banda and v_sep_fuera and v_sup_min and v_sup_flexion ="
  },
  {
   "id": "r103",
   "kind": "text",
   "x": 40,
   "y": 5576,
   "src": "━━ ESQUEMA · MAPEO A PÍXELES ━━",
   "imprimir": false
  },
  {
   "id": "r104",
   "kind": "text",
   "x": 40,
   "y": 5624,
   "src": "El dibujo sale de las mismas variables que las verificaciones: una cota roja y un v_* en falso son\nel mismo número. Planta y elevación comparten escala. px y py llevan una distancia medida desde el\ncentro de la zapata a píxeles de planta; ex y ey hacen lo propio en elevación, con ey medida hacia\nabajo desde la cara superior de la zapata. Este bloque no se imprime.",
   "imprimir": false
  },
  {
   "id": "r105",
   "kind": "math",
   "x": 40,
   "y": 5744,
   "src": "esc := min(330/(ZAP_X/(1 m)), 220/(ZAP_Y/(1 m))) =",
   "imprimir": false
  },
  {
   "id": "r106",
   "kind": "program",
   "x": 40,
   "y": 5792,
   "src": "px(u) := 250 + u/(1 m)*esc",
   "imprimir": false
  },
  {
   "id": "r107",
   "kind": "program",
   "x": 40,
   "y": 5840,
   "src": "py(v) := 200 + v/(1 m)*esc",
   "imprimir": false
  },
  {
   "id": "r108",
   "kind": "program",
   "x": 40,
   "y": 5888,
   "src": "ey(w) := 430 + w/(1 m)*esc",
   "imprimir": false
  },
  {
   "id": "r109",
   "kind": "math",
   "x": 40,
   "y": 5936,
   "src": "ped_h := 0.60 m",
   "imprimir": false
  },
  {
   "id": "r110",
   "kind": "program",
   "x": 40,
   "y": 5984,
   "src": "barras_banda :=\n    n := floor(ZAP_X/sep_banda) + 1\n    Q := zeros(n, 1)\n    for i in 1:n\n        Q[i, 1] = py(-ZAP_X/2 + (i - 1)*sep_banda)\n    Q",
   "imprimir": false
  },
  {
   "id": "r_cu",
   "kind": "program",
   "x": 40,
   "y": 6152,
   "src": "cu(u) := u <= 1 ? \"#1c7c3c\" : \"#c0392b\"",
   "imprimir": false
  },
  {
   "id": "r111",
   "kind": "math",
   "x": 40,
   "y": 6200,
   "src": "col_flex := v_As_prov ? \"#1c7c3c\" : \"#c0392b\"",
   "imprimir": false
  },
  {
   "id": "r112",
   "kind": "math",
   "x": 40,
   "y": 6248,
   "src": "col_corte := (u_corte_Y <= 1 and u_corte_X <= 1) ? \"#1c7c3c\" : \"#c0392b\"",
   "imprimir": false
  },
  {
   "id": "r113",
   "kind": "math",
   "x": 40,
   "y": 6296,
   "src": "col_punz := u_punz <= 1 ? \"#1c7c3c\" : \"#c0392b\"",
   "imprimir": false
  },
  {
   "id": "r114",
   "kind": "math",
   "x": 40,
   "y": 6344,
   "src": "col_banda := (v_sep_banda and v_sep_fuera) ? \"#1c7c3c\" : \"#c0392b\"",
   "imprimir": false
  },
  {
   "id": "r115",
   "kind": "math",
   "x": 40,
   "y": 6392,
   "src": "col_sup := v_sup_flexion ? \"#1c7c3c\" : \"#c0392b\"",
   "imprimir": false
  },
  {
   "id": "r116",
   "kind": "math",
   "x": 40,
   "y": 6440,
   "src": "col_global := v_global ? \"#1c7c3c\" : \"#c0392b\"",
   "imprimir": false
  },
  {
   "id": "esquema",
   "kind": "image",
   "x": 40,
   "y": 6488,
   "src": "/esquemas/zapata-generica.svg",
   "w": 720,
   "h": 480
  }
 ]
}
